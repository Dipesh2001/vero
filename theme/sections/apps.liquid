<div class="{% if section.settings.include_margins %}page-width{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
  {%- for block in section.blocks -%}
    {% render block %}
  {%- endfor -%}
</div>
{% if section.settings.title_font_size_mobile %}
<style>
  .shopify-app-block[id*="instafeed_app_block"] #insta-feed h2 {
    font-size: {{ section.settings.title_font_size_mobile }}px !important;
  }
  @media screen and (min-width: 750px) {
    .shopify-app-block[id*="instafeed_app_block"] #insta-feed h2 {
      font-size: 28px !important;
    }
  }
</style>
{% endif %}
{% schema %}
{
  "name": "t:sections.apps.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "include_margins",
      "default": true,
      "label": "t:sections.apps.settings.include_margins.label"
    },
    {
      "type": "number",
      "id": "title_font_size_mobile",
      "label": "Mobile Title Font Size (px)",
      "default": 15
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "t:sections.apps.presets.name"
    }
  ]
}
{% endschema %}
