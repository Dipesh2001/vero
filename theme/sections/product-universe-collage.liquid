{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Kalnia:wght@300;400;500;700&family=Mulish:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&display=swap');

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .collage-wrapper-{{ section.id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: transparent;
  }

  .collage-heading-wrapper-{{ section.id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 10;
    pointer-events: none; /* Allows user to drag the background images through the text */
    text-align: center;
    width: 100%;
    padding: 0 20px;
    box-sizing: border-box;
  }

  .collage-heading-{{ section.id }} {
    font-family: 'Kalnia', serif;
    font-size: 36px;
    font-weight: 400;
    color: rgb(var(--color-foreground));
    margin: 0;
    text-shadow: 0 0 20px rgba(var(--color-background), 0.8), 0 0 10px rgba(var(--color-background), 0.9);
  }

  @media screen and (min-width: 750px) {
    .collage-heading-{{ section.id }} {
      font-size: 64px;
    }
  }

  .collage-marquee-row-{{ section.id }} {
    display: flex;
    flex-direction: row;
    width: 100%;
    overflow-x: hidden;
    white-space: nowrap;
    cursor: grab;
    user-select: none;
    padding: 24px 0;
  }

  .collage-marquee-row-{{ section.id }}:active {
    cursor: grabbing;
  }

  .collage-item-{{ section.id }} {
    position: relative;
    width: 200px;
    height: 130px;
    margin-right: 24px;
    border-radius: 8px;
    overflow: hidden;
    background-color: rgba(var(--color-foreground), 0.03);
    transition: transform 0.4s ease, box-shadow 0.4s ease;
    flex-shrink: 0;
    display: inline-block;
  }

  @media screen and (min-width: 750px) {
    .collage-item-{{ section.id }} {
      width: 293px;
      height: 189px;
      margin-right: 32px;
    }
    
    .collage-item-{{ section.id }}:hover {
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
      transform: scale(1.03) !important;
    }

    /* Asymmetrical Floating Offsets inside rows */
    #marquee-row-1-{{ section.id }} .collage-item-{{ section.id }}:nth-child(3n+1) {
      transform: translateY(-16px);
    }
    #marquee-row-1-{{ section.id }} .collage-item-{{ section.id }}:nth-child(3n+2) {
      transform: translateY(16px);
    }
    #marquee-row-1-{{ section.id }} .collage-item-{{ section.id }}:nth-child(3n+3) {
      transform: translateY(0);
    }

    #marquee-row-2-{{ section.id }} .collage-item-{{ section.id }}:nth-child(3n+1) {
      transform: translateY(12px);
    }
    #marquee-row-2-{{ section.id }} .collage-item-{{ section.id }}:nth-child(3n+2) {
      transform: translateY(-12px);
    }
    #marquee-row-2-{{ section.id }} .collage-item-{{ section.id }}:nth-child(3n+3) {
      transform: translateY(0);
    }
  }

  .collage-image-{{ section.id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none; /* Prevents ghost dragging of images */
  }

  .collage-caption-{{ section.id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    background: linear-gradient(to top, rgba(0,0,0,0.6), transparent);
    color: #ffffff;
    font-family: 'Mulish', sans-serif;
    font-size: 12px;
    font-weight: 300;
    padding: 12px;
    margin: 0;
    box-sizing: border-box;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .collage-item-{{ section.id }}:hover .collage-caption-{{ section.id }} {
    opacity: 1;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="collage-wrapper-{{ section.id }}">
    
    {%- comment -%} Centered section heading (overlay layer) {%- endcomment -%}
    {%- if section.settings.title != blank -%}
      <div class="collage-heading-wrapper-{{ section.id }}">
        <h2 class="collage-heading-{{ section.id }}">{{ section.settings.title }}</h2>
      </div>
    {%- endif -%}

    {%- capture placeholder_class -%}collage-image-{{ section.id }}{%- endcapture -%}

    {%- comment -%} Row 1: Odd blocks scrolling Right-to-Left {%- endcomment -%}
    <div class="collage-marquee-row-{{ section.id }}" id="marquee-row-1-{{ section.id }}">
      {%- for i in (1..4) -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'image' -%}
            {%- assign mod = forloop.index | modulo: 2 -%}
            {%- if mod != 0 -%}
              <div class="collage-item-{{ section.id }}" {{ block.shopify_attributes }}>
                {%- if block.settings.image != blank -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 600 }}"
                    alt="{{ block.settings.image.alt | escape }}"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                    loading="lazy"
                    class="collage-image-{{ section.id }}"
                  >
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: placeholder_class }}
                {%- endif -%}
                {%- if block.settings.caption != blank -%}
                  <p class="collage-caption-{{ section.id }}">{{ block.settings.caption | escape }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    </div>

    {%- comment -%} Row 2: Even blocks scrolling Left-to-Right {%- endcomment -%}
    <div class="collage-marquee-row-{{ section.id }}" id="marquee-row-2-{{ section.id }}">
      {%- for i in (1..4) -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'image' -%}
            {%- assign mod = forloop.index | modulo: 2 -%}
            {%- if mod == 0 -%}
              <div class="collage-item-{{ section.id }}" {{ block.shopify_attributes }}>
                {%- if block.settings.image != blank -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 600 }}"
                    alt="{{ block.settings.image.alt | escape }}"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                    loading="lazy"
                    class="collage-image-{{ section.id }}"
                  >
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: placeholder_class }}
                {%- endif -%}
                {%- if block.settings.caption != blank -%}
                  <p class="collage-caption-{{ section.id }}">{{ block.settings.caption | escape }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    </div>

  </div>
</div>

<script>
  (function() {
    function initMarquee(row, speed) {
      if (!row) return;

      let isDown = false;
      let startX;
      let scrollLeft;
      let velX = 0;
      let momentumID;
      let autoScrollID;
      let singleSetWidth = 0;

      function updateDimensions() {
        singleSetWidth = row.scrollWidth / 4;
      }

      // Initial dimension setup
      updateDimensions();
      row.scrollLeft = singleSetWidth;

      // Recalculate on resize or media load
      window.addEventListener('resize', updateDimensions);
      row.querySelectorAll('img').forEach(img => {
        img.addEventListener('load', updateDimensions);
      });

      function step() {
        if (!isDown) {
          row.scrollLeft += speed;

          // Seamless loop boundary resets
          if (row.scrollLeft >= singleSetWidth * 2.5) {
            row.scrollLeft -= singleSetWidth;
          } else if (row.scrollLeft <= singleSetWidth * 0.5) {
            row.scrollLeft += singleSetWidth;
          }
        }
        autoScrollID = requestAnimationFrame(step);
      }

      autoScrollID = requestAnimationFrame(step);

      // Mouse drag events
      row.addEventListener('mousedown', (e) => {
        isDown = true;
        startX = e.pageX - row.offsetLeft;
        scrollLeft = row.scrollLeft;
        cancelAnimationFrame(momentumID);
        velX = 0;
      });

      row.addEventListener('mouseleave', () => {
        if (isDown) {
          isDown = false;
          beginMomentum();
        }
      });

      row.addEventListener('mouseup', () => {
        if (isDown) {
          isDown = false;
          beginMomentum();
        }
      });

      row.addEventListener('mousemove', (e) => {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - row.offsetLeft;
        const walk = (x - startX) * 1.5;
        
        const prevScroll = row.scrollLeft;
        row.scrollLeft = scrollLeft - walk;
        velX = row.scrollLeft - prevScroll;

        // Boundaries check during drag
        if (row.scrollLeft >= singleSetWidth * 2.5) {
          row.scrollLeft -= singleSetWidth;
          scrollLeft -= singleSetWidth;
        } else if (row.scrollLeft <= singleSetWidth * 0.5) {
          row.scrollLeft += singleSetWidth;
          scrollLeft += singleSetWidth;
        }
      });

      // Touch swipe events
      row.addEventListener('touchstart', (e) => {
        isDown = true;
        startX = e.touches[0].pageX - row.offsetLeft;
        scrollLeft = row.scrollLeft;
        cancelAnimationFrame(momentumID);
        velX = 0;
      });

      row.addEventListener('touchend', () => {
        if (isDown) {
          isDown = false;
          beginMomentum();
        }
      });

      row.addEventListener('touchmove', (e) => {
        if (!isDown) return;
        const x = e.touches[0].pageX - row.offsetLeft;
        const walk = (x - startX) * 1.5;
        
        const prevScroll = row.scrollLeft;
        row.scrollLeft = scrollLeft - walk;
        velX = row.scrollLeft - prevScroll;

        if (row.scrollLeft >= singleSetWidth * 2.5) {
          row.scrollLeft -= singleSetWidth;
          scrollLeft -= singleSetWidth;
        } else if (row.scrollLeft <= singleSetWidth * 0.5) {
          row.scrollLeft += singleSetWidth;
          scrollLeft += singleSetWidth;
        }
      });

      function beginMomentum() {
        function momentum() {
          if (Math.abs(velX) > 0.15) {
            row.scrollLeft += velX;
            velX *= 0.92; // Friction damping

            if (row.scrollLeft >= singleSetWidth * 2.5) {
              row.scrollLeft -= singleSetWidth;
            } else if (row.scrollLeft <= singleSetWidth * 0.5) {
              row.scrollLeft += singleSetWidth;
            }
            momentumID = requestAnimationFrame(momentum);
          }
        }
        momentumID = requestAnimationFrame(momentum);
      }
    }

    function initCollageMarquee() {
      const row1 = document.getElementById('marquee-row-1-{{ section.id }}');
      const row2 = document.getElementById('marquee-row-2-{{ section.id }}');
      
      initMarquee(row1, 0.7);  // Right to Left
      initMarquee(row2, -0.7); // Left to Right
    }

    document.addEventListener('DOMContentLoaded', initCollageMarquee);
    document.addEventListener('shopify:section:load', function(e) {
      if (e.detail.sectionId === '{{ section.id }}') {
        initCollageMarquee();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Product Universe Collage",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Our Product Universe",
      "label": "Heading"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-8"
    },
    {
      "type": "header",
      "content": "Desktop Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top Spacing",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom Spacing",
      "default": 48
    },
    {
      "type": "header",
      "content": "Mobile Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Mobile Top Spacing",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Mobile Bottom Spacing",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Collage Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Universe Collage",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
