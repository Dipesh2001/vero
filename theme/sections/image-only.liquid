{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .image-only-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    background-color: {{ section.settings.background_color | default: 'transparent' }};
  }

  @media screen and (min-width: 750px) {
    .image-only-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {%- if section.settings.make_full_width_mobile -%}
    @media screen and (max-width: 749px) {
      .image-only-{{ section.id }} .page-width {
        padding: 0 !important;
        max-width: 100% !important;
      }
      .image-only__container-{{ section.id }} {
        max-width: 100% !important;
      }
    }
  {%- endif -%}

  .image-only__container-{{ section.id }} {
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    max-width: {{ section.settings.max_width }}px;
    width: 100%;
  }

  .image-only__wrapper {
    width: 100%;
    position: relative;
  }

  .image-only__image {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }
{%- endstyle -%}

<div class="image-only-{{ section.id }}">
  <div class="{% unless section.settings.make_full_width %}page-width{% endunless %}">
    <div class="image-only__container-{{ section.id }}">
      <div class="image-only__wrapper">
        {%- if section.settings.image != blank -%}
          {%- if section.settings.link != blank -%}
            <a href="{{ section.settings.link }}" class="image-only__link">
          {%- endif -%}

          {%- if section.settings.image_mobile != blank -%}
            <picture>
              <source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 750 }}">
              <source media="(min-width: 750px)" srcset="{{ section.settings.image | image_url: width: 1500 }}">
              <img
                src="{{ section.settings.image | image_url: width: 1500 }}"
                alt="{{ section.settings.image.alt | escape }}"
                class="image-only__image"
                loading="lazy"
                width="{{ section.settings.image.width }}"
                height="{{ section.settings.image.height }}"
              >
            </picture>
          {%- else -%}
            {{
              section.settings.image
              | image_url: width: 1500
              | image_tag:
                loading: 'lazy',
                width: section.settings.image.width,
                height: section.settings.image.height,
                class: 'image-only__image',
                alt: section.settings.image.alt
            }}
          {%- endif -%}

          {%- if section.settings.link != blank -%}
            </a>
          {%- endif -%}
        {%- else -%}
          <div class="placeholder-background" style="background-color: #f3f3f3; width: 100%; aspect-ratio: 16/9; display: flex; justify-content: center; align-items: center;">
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image Only",
  "tag": "section",
  "class": "section section-image-only",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Image (Optional)"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Image Link"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 200,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Maximum Width of Image",
      "default": 1200
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section Background Color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "make_full_width",
      "default": false,
      "label": "Make section full width"
    },
    {
      "type": "checkbox",
      "id": "make_full_width_mobile",
      "default": false,
      "label": "Make section full width in mobile"
    },
    {
      "type": "header",
      "content": "Desktop Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 36
    },
    {
      "type": "header",
      "content": "Mobile Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Top Padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Bottom Padding",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Image Only"
    }
  ]
}
{% endschema %}
