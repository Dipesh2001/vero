<style>
  .custom-newsletter-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  @media screen and (min-width: 750px) {
    .custom-newsletter-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .vero-inline-newsletter-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    width: 100%;
  }

  @media screen and (min-width: 990px) {
    .vero-inline-newsletter-wrapper {
      flex-direction: row;
      gap: 50px;
    }
  }

  .vero-inline-newsletter-text {
    flex: 1;
    max-width: 690px;
  }

  .vero-inline-newsletter-heading {
    font-family: var(--font-heading-custom) !important;
    font-style: normal !important;
    font-weight: 400 !important;
    font-size: 28px !important;
    line-height: 1.3 !important;
    color: rgb(var(--color-foreground)) !important;
    margin: 0;
  }
  
  .vero-inline-newsletter-subheading {
    font-family: var(--font-heading-custom) !important;
    font-style: normal !important;
    font-weight: 400 !important;
    font-size: 16px !important;
    color: {{ section.settings.subheading_color }} !important;
    margin: 10px 0 0 0;
  }

  @media screen and (max-width: 749px) {
    .vero-inline-newsletter-heading {
      font-size: 22px !important;
      text-align: center;
    }
    .vero-inline-newsletter-subheading {
      font-size: 14px !important;
      text-align: center;
    }
  }

  .vero-inline-newsletter-form-container {
    flex: 1;
    width: 100%;
    max-width: {{ section.settings.form_width }}px;
    position: relative;
  }

  .vero-inline-newsletter-form {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
  }

  .vero-inline-newsletter-input {
    width: 100%;
    height: 70px;
    border: 1px solid rgb(var(--color-foreground));
    border-radius: 6px;
    padding: 0 170px 0 20px;
    font-family: var(--font-heading-custom) !important;
    font-weight: 400 !important;
    font-size: 18px !important;
    color: rgb(var(--color-foreground));
    background-color: transparent;
    outline: none;
    transition: border-color 0.3s ease;
  }
  @media screen and (max-width: 749px) {
    .vero-inline-newsletter-input {
      height: 60px;
      font-size: 16px !important;
      padding: 0 130px 0 15px;
    }
  }

  .vero-inline-newsletter-input:focus {
    border-color: rgb(var(--color-button));
  }

  .vero-inline-newsletter-input::placeholder {
    color: #868686;
  }

  .vero-inline-newsletter-btn {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    height: 54px;
    padding: 0 25px;
    background-color: rgb(var(--color-button));
    color: rgb(var(--color-button-text));
    border: 1px solid rgb(var(--color-button));
    border-radius: 14px;
    font-family: var(--font-heading-custom) !important;
    font-weight: 400 !important;
    font-size: 18px !important;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  @media screen and (max-width: 749px) {
    .vero-inline-newsletter-btn {
      height: 44px;
      font-size: 16px !important;
      padding: 0 15px;
      right: 8px;
    }
  }

  .vero-inline-newsletter-btn:hover {
    background-color: transparent;
    color: rgb(var(--color-button));
  }

  .vero-newsletter-message {
    position: absolute;
    bottom: -25px;
    left: 0;
    font-family: var(--font-heading-custom);
    font-size: 14px;
    margin: 0;
  }
  .vero-newsletter-message.error {
    color: #ff5e5e;
  }
  .vero-newsletter-message.success {
    color: #4caf50;
  }
</style>

<div class="custom-newsletter-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="{% unless section.settings.full_width %}page-width{% else %}page-width--full{% endunless %}" style="{% if section.settings.full_width %}padding: 0 40px;{% endif %}">
    <div class="vero-inline-newsletter-wrapper">
      
      <div class="vero-inline-newsletter-text">
        {%- if section.settings.heading != blank -%}
          <h2 class="vero-inline-newsletter-heading">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <div class="vero-inline-newsletter-subheading">
            {{ section.settings.subheading }}
          </div>
        {%- endif -%}
      </div>

      <div class="vero-inline-newsletter-form-container">
        {% form 'customer', class: 'vero-inline-newsletter-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          
          <input
            type="email"
            name="contact[email]"
            class="vero-inline-newsletter-input"
            value="{{ form.email }}"
            placeholder="{{ section.settings.placeholder_text | default: 'Enter your email address' }}"
            required
          >
          
          <button type="submit" class="vero-inline-newsletter-btn">
            {{ section.settings.button_text | default: 'Subscribe' }}
          </button>

          {%- if form.errors -%}
            <p class="vero-newsletter-message error">
              {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
            </p>
          {%- endif -%}
          {%- if form.posted_successfully? -%}
            <p class="vero-newsletter-message success">
              Thank you for subscribing!
            </p>
          {%- endif -%}
        {% endform %}
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom Newsletter",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-2"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "default": false,
      "label": "Make section full width"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Be the first to hear all things about Vero",
      "label": "Heading Text"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "default": "<p>Sign up to receive exclusive offers and news.</p>",
      "label": "Subheading Text"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "#A1A1A1"
    },
    {
      "type": "header",
      "content": "Form Settings"
    },
    {
      "type": "text",
      "id": "placeholder_text",
      "default": "Enter your email address",
      "label": "Input Placeholder"
    },
    {
      "type": "text",
      "id": "button_text",
      "default": "Subscribe",
      "label": "Button Text"
    },
    {
      "type": "range",
      "id": "form_width",
      "min": 400,
      "max": 800,
      "step": 10,
      "unit": "px",
      "label": "Form Max Width",
      "default": 600
    },
    {
      "type": "header",
      "content": "Desktop Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 40
    },
    {
      "type": "header",
      "content": "Mobile Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Top Padding",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Bottom Padding",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Custom Newsletter"
    }
  ]
}
{% endschema %}
