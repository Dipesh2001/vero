{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer="defer"></script>

{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'section-related-products.css' | asset_url | stylesheet_tag }}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Product Card Premium Styling */
  .product-card-premium {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    position: relative;
    box-sizing: border-box;
  }
  .product-card-premium product-form {
    margin-top: auto;
  }

  /* Image Box Wrapper */
  .product-card-image-box {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #faf9f9;
    border: 1px solid #f2eadf;
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  /* Miniature Swiper inside Card */
  .product-card-media-swiper.swiper {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
  }
  .product-card-media-swiper .card-swiper-slide {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .product-card-media-swiper img {
    max-width: 85%;
    max-height: 85%;
    object-fit: contain;
    display: block;
    pointer-events: none;
  }

  /* Swatches Navigation & Scroll */
  .product-swatches-outer-wrapper {
    display: flex;
    align-items: center;
    width: 100%;
    margin-bottom: 1rem;
    position: relative;
  }

  .swatch-scroll-btn {
    background: none;
    border: none;
    cursor: pointer;
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #00237d;
    padding: 0;
    z-index: 2;
  }
  .swatch-scroll-btn svg {
    width: 10px;
    height: 10px;
    transition: transform 0.2s ease;
  }
  .swatch-scroll-prev svg {
    transform: rotate(90px);
  }
  .swatch-scroll-next svg {
    transform: rotate(-90px);
  }

  .swatches-scroll-container {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding: 2px 4px;
    flex-grow: 1;
    align-items: center;
  }
  .swatches-scroll-container::-webkit-scrollbar {
    display: none;
  }

  /* Card Swiper Arrows */
  .card-swiper-btn {
    position: absolute !important;
    z-index: 10 !important;
    width: 28px !important;
    height: 28px !important;
    background: #ffffff !important;
    color: #000000 !important;
    border-radius: 50%;
    box-shadow: 0 2px 5px rgba(0,0,0,0.15);
    margin-top: 0 !important;
    transform: translateY(-50%) !important;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .card-swiper-btn.swiper-button-prev {
    left: 10px !important;
  }
  .card-swiper-btn.swiper-button-next {
    right: 10px !important;
  }
  .product-card-image-box:hover .card-swiper-btn:not(.swiper-button-disabled) {
    opacity: 1 !important;
  }
  .card-swiper-btn::after {
    font-size: 12px !important;
    font-weight: 900;
    display: block;
  }
  .card-swiper-btn.swiper-button-disabled {
    opacity: 0 !important;
    pointer-events: none;
  }

  /* Color Swatch Button */
  .color-swatch-btn-wrapper {
    position: relative;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .color-swatch-btn {
    width: 24px;
    height: 24px;
    border-radius: 4px;
    border: 1px solid #00237d;
    background-size: cover;
    background-position: center;
    cursor: pointer;
    box-sizing: border-box;
    padding: 0;
    transition: transform 0.15s ease;
  }
  .color-swatch-btn:hover {
    transform: scale(1.05);
  }
  .color-swatch-btn-wrapper.is-active::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 28px;
    height: 28px;
    border: 1px solid #00237d;
    border-radius: 4px;
    box-sizing: border-box;
    pointer-events: none;
  }

  /* Selected Swatch Description (Size | Color) */
  .selected-color-text {
    font-family: 'Inter', sans-serif;
    font-size: 1.2rem;
    color: #454545;
    margin: 0 0 1rem 0;
    text-align: left;
    min-height: 1.8rem;
  }

  /* Product Meta Details */
  .product-card-details {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    text-align: left;
  }
  .product-card-title {
    font-family: 'Inter', sans-serif;
    font-size: 1.6rem;
    font-weight: 500;
    color: #00237d;
    margin: 0;
    line-height: 1.3;
    text-decoration: none;
    display: inline-block;
  }
  .product-card-title:hover {
    opacity: 0.8;
  }

  /* Prices Section */
  .product-card-price-container {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: 'Inter', sans-serif;
    font-size: 1.6rem;
    color: #00237d;
  }
  .product-card-price-value {
    font-weight: 600;
  }
  .product-card-compare-price {
    font-size: 1.4rem;
    color: #888888;
    text-decoration: line-through;
  }
  .product-card-discount-percent {
    font-size: 1.1rem;
    font-weight: 700;
    color: #cc0000;
    background-color: #ffe6e6;
    padding: 2px 6px;
    border-radius: 4px;
  }

  /* Badges overlay styles */
  .modern-badges-container--overlay {
    position: absolute;
    top: 12px;
    left: 12px;
    right: 12px;
    z-index: 10;
    pointer-events: none;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    width: calc(100% - 24px);
  }
  .modern-badges-left {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .modern-badges-right {
    margin-left: auto;
  }
  .modern-badge {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    padding: 4px 8px;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.05rem;
    display: inline-block;
    line-height: 1;
  }
  .modern-badge--promo {
    background-color: #ffc356;
    color: #ffffff;
  }
  .modern-badge--sale {
    background-color: #cc0000;
    color: #ffffff;
  }
  .modern-badge--new {
    background-color: #c8e9fc;
    color: #00237d;
  }
  .modern-badge--bestseller {
    background-color: #ffdcd3;
    color: #ff5a3c;
  }
  .modern-badge--featured {
    background-color: #bab8dd;
    color: #4b3d8f;
  }
  .modern-badge--sold-out {
    background-color: #454545;
    color: #ffffff;
  }

  /* Add to Bag Button */
  .product-card-submit-btn {
    background-color: rgb(var(--color-button, 0, 35, 125)) !important;
    color: rgb(var(--color-button-text, 255, 255, 255)) !important;
    border: none;
    border-radius: 4px;
    height: 62px;
    font-family: var(--font-body-family, 'Inter', sans-serif);
    font-size: 1.4rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    transition: background-color 0.2s ease, transform 0.1s ease;
    width: 100%;
    margin-top: 1.5rem;
    padding: 0;
  }
  .product-card-submit-btn:hover {
    opacity: 0.9;
  }
  .product-card-submit-btn:active {
    transform: scale(0.98);
  }
  .product-card-submit-btn[disabled] {
    background-color: #cccccc !important;
    color: #888888 !important;
    cursor: not-allowed;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <product-recommendations
    class="related-products page-width section-{{ section.id }}-padding isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    data-url="{{ routes.product_recommendations_url }}?limit={{ section.settings.products_to_show }}"
    data-section-id="{{ section.id }}"
    data-product-id="{{ product.id }}"
  >
    {% if recommendations.performed and recommendations.products_count > 0 %}
      <h2 class="related-products__heading inline-richtext {{ section.settings.heading_size }}">
        {{ section.settings.heading }}
      </h2>
      <ul
        class="grid product-grid grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ section.settings.columns_mobile }}-col-tablet-down"
        role="list"
        id="product-grid-related"
      >
        {% for recommendation in recommendations.products %}
          <li class="grid__item">
            {% render 'premium-product-card',
              card_product: recommendation,
              section_id: section.id
            %}
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </product-recommendations>
  {% if section.settings.image_shape == 'arch' %}
    {{ 'mask-arch.svg' | inline_asset_content }}
  {%- endif -%}
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const initCards = () => {
      const cards = document.querySelectorAll('#product-grid-related .js-product-card');
      cards.forEach(card => {
        if (typeof window.PremiumProductCard !== 'undefined' && !card.classList.contains('initialized')) {
          new window.PremiumProductCard(card);
          card.classList.add('initialized');
        }
      });
    };
    
    // Initial run
    initCards();
    
    // Run whenever the product grid updates
    const observer = new MutationObserver(initCards);
    const recContainer = document.querySelector('product-recommendations');
    if (recContainer) {
      observer.observe(recContainer, { childList: true, subtree: true });
    }
  });
</script>

{% schema %}
{
  "name": "t:sections.related-products.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.related-products.settings.paragraph__1.content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "t:sections.related-products.settings.paragraph__1.default",
      "label": "t:sections.related-products.settings.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
