<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

<style>
  /* Section Padding */
  .collections-listing-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile | default: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile | default: 0 }}px;
    position: relative;
    overflow: hidden;
  }
  @media screen and (min-width: 750px) {
    .collections-listing-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | default: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | default: 0 }}px;
    }
  }

  /* Header Styling matching custom-carousel */
  .collections-listing-section-{{ section.id }} .carousel__header {
    text-align: {{ section.settings.heading_alignment | default: 'center' }};
    margin-bottom: 3rem;
  }
  .collections-listing-section-{{ section.id }} .carousel__header h2 {
    font-family: var(--font-body-custom);
    font-weight: 700;
    font-size: 2.8rem;
    color: rgb(var(--color-foreground)) !important;
    margin: 0;
    line-height: 1.2;
  }
  @media screen and (min-width: 750px) {
    .collections-listing-section-{{ section.id }} .carousel__header h2 {
      font-size: 4rem; /* 40px */
    }
  }

  /* Swiper relative container to position arrows outside */
  .swiper-container-relative-{{ section.id }} {
    position: relative;
    padding-top: 10px; /* Reduced to match Figma's header-to-card gap */
    padding-bottom: 20px;
  }
  @media screen and (min-width: 750px) {
    .swiper-container-relative-{{ section.id }} {
      padding: 10px 40px 20px 40px;
    }
  }

  .swiper-container-{{ section.id }}.swiper {
    width: 100%;
    height: auto;
    overflow: visible !important;
    clip-path: inset(-100px -100px -100px -100px);
  }

  /* Category Item Cards */
  .collections-listing-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    width: 100%;
  }

  .collections-listing-image-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    margin-bottom: 2rem;
    transition: transform 0.3s ease;
    border-radius: {{ section.settings.image_border_radius }}px;
  }

  .collections-listing-card:hover .collections-listing-image-wrapper {
    transform: scale(1.02);
  }

  .collections-listing-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  /* Aspect Ratios */
  .image-ratio-square .collections-listing-image-wrapper {
    aspect-ratio: 1 / 1;
  }
  .image-ratio-portrait .collections-listing-image-wrapper {
    aspect-ratio: 4 / 5;
  }
  .image-ratio-landscape .collections-listing-image-wrapper {
    aspect-ratio: 16 / 9;
  }
  .image-ratio-adapt .collections-listing-image-wrapper {
    aspect-ratio: auto;
  }

  /* Titles styling */
  .collections-listing-title {
    font-family: var(--font-body-custom);
    font-size: 1.8rem;
    font-weight: 600;
    color: {{ section.settings.title_color | default: '#00237d' }} !important;
    margin: 0;
    line-height: 1.3;
    transition: opacity 0.2s ease, text-decoration 0.2s ease;
  }
  @media screen and (min-width: 750px) {
    .collections-listing-title {
      font-size: 2.4rem;
    }
  }

  .collections-listing-card:hover .collections-listing-title {
    opacity: 0.8;
    text-decoration: underline;
  }

  /* Horizontal Layout (Text on Left, Image on Right - Figma Pop-out overlap style) */
  .collections-listing-card-horizontal {
    display: block;
    position: relative;
    width: 100%;
    height: 180px; /* Adjusted to fit popout heights with minimal padding */
    text-decoration: none;
    box-sizing: border-box;
  }
  @media screen and (max-width: 749px) {
    .collections-listing-card-horizontal {
      height: 120px;
    }
  }

  .collections-listing-card-bg {
    position: absolute;
    bottom: 40px; /* Lifted 10px more to lower the relative bottom position of the image */
    left: 0;
    width: calc(100% - 25px); /* Leave room on the right for image overhang */
    height: 90px; /* Small card background size matching Figma (90px) */
    border-radius: 22px; /* Figma cornerRadius: 22 */
    display: flex;
    align-items: center;
    padding-left: 2.5rem;
    padding-right: 1.5rem;
    box-sizing: border-box;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    z-index: 1;
  }
  @media screen and (max-width: 749px) {
    .collections-listing-card-bg {
      height: 65px;
      padding-left: 1.5rem;
      width: calc(100% - 15px);
      bottom: 22px; /* Lifted on mobile as well */
    }
  }

  .collections-listing-horizontal-text {
    width: 60%; /* Ensure text doesn't flow under absolute image */
    display: flex;
    align-items: center;
    z-index: 2;
  }

  .collections-listing-horizontal-title {
    font-family: 'Poppins', var(--font-body-custom);
    font-size: 1.8rem;
    font-weight: 800; /* ExtraBold matching Figma (800) */
    margin: 0;
    line-height: 1.3;
    word-break: break-word;
    text-align: left;
    text-transform: none;
    color: #ffffff; /* All text colors white */
  }
  @media screen and (min-width: 750px) {
    .collections-listing-horizontal-title {
      font-size: 1.8rem; /* Exact same 18px size from Figma */
    }
  }

  .collections-listing-horizontal-image-wrapper {
    position: absolute;
    right: 0;
    bottom: 0; /* Aligned to container bottom, creating bottom overlap */
    width: 150px; 
    height: 180px; /* Larger than card height, pops out at top and bottom */
    display: flex;
    align-items: flex-end;
    justify-content: center;
    z-index: 3;
    pointer-events: none;
  }
  @media screen and (max-width: 749px) {
    .collections-listing-horizontal-image-wrapper {
      width: 100px;
      height: 115px;
      bottom: 0;
    }
  }

  .collections-listing-horizontal-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    transform-origin: bottom center;
    transition: transform 0.3s ease;
  }

  /* Interactive Hover Effects */
  .collections-listing-card-horizontal:hover .collections-listing-card-bg {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
  }

  .collections-listing-card-horizontal:hover .collections-listing-horizontal-image {
    transform: scale(1.06) translateY(-2px);
  }

  /* Navigation Arrows - Match Figma size and custom carousel styling */
  .swiper-button-prev-{{ section.id }}.swiper-button-prev,
  .swiper-button-next-{{ section.id }}.swiper-button-next {
    width: 35px;
    height: 35px;
    background: rgb(var(--color-button)) !important;
    color: rgb(var(--color-button-text)) !important;
    border-radius: 50%;
    display: flex !important;
    align-items: center;
    justify-content: center;
    position: absolute;
    top: 50% !important;
    transform: translateY(-50%) !important;
    margin-top: 0 !important;
    z-index: 10;
    cursor: pointer;
    border: none;
  }

  .swiper-button-prev-{{ section.id }}.swiper-button-prev::after,
  .swiper-button-next-{{ section.id }}.swiper-button-next::after {
    font-size: 16px !important;
    font-weight: 900;
    line-height: 1;
    display: block;
  }

  .swiper-button-prev-{{ section.id }} { left: 10px; }
  .swiper-button-next-{{ section.id }} { right: 10px; }

  @media screen and (min-width: 750px) {
    .swiper-button-prev-{{ section.id }} { left: 0; }
    .swiper-button-next-{{ section.id }} { right: 0; }
  }

  @media screen and (max-width: 749px) {
    .swiper-button-prev-{{ section.id }},
    .swiper-button-next-{{ section.id }} {
      display: none !important;
    }
  }
</style>

<div class="collections-listing-section-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  {%- if section.settings.heading != blank -%}
    <div class="carousel__header page-width">
      <h2>{{ section.settings.heading | escape }}</h2>
    </div>
  {%- endif -%}

  <div class="collections-listing-wrapper-{{ section.id }} page-width">
    <div class="swiper-container-relative-{{ section.id }}">
      <div class="swiper swiper-container-{{ section.id }} image-ratio-{{ section.settings.image_ratio }}">
        <div class="swiper-wrapper">
          {%- for block in section.blocks -%}
            {% if block.type == 'collection_item' %}
              <div class="swiper-slide" {{ block.shopify_attributes }}>
                {%- if block.settings.link != blank -%}
                  {%- if section.settings.listing_type == 'text_image' -%}
                    <a href="{{ block.settings.link }}" class="collections-listing-card-horizontal">
                  {%- else -%}
                    <a href="{{ block.settings.link }}" class="collections-listing-card">
                  {%- endif -%}
                {%- else -%}
                  {%- if section.settings.listing_type == 'text_image' -%}
                    <div class="collections-listing-card-horizontal">
                  {%- else -%}
                    <div class="collections-listing-card">
                  {%- endif -%}
                {%- endif -%}

                  {%- if section.settings.listing_type == 'text_image' -%}
                    <div class="collections-listing-card-bg" style="background-color: {{ block.settings.card_bg_color | default: '#eaeaea' }};">
                      <div class="collections-listing-horizontal-text">
                        {%- if block.settings.title != blank -%}
                          <h3 class="collections-listing-horizontal-title" style="color: {{ block.settings.card_text_color | default: '#ffffff' }};">{{ block.settings.title | escape }}</h3>
                        {%- endif -%}
                      </div>
                    </div>

                    <div class="collections-listing-horizontal-image-wrapper">
                      {%- if block.settings.image != blank -%}
                        {%- liquid
                          assign desktop_image = block.settings.image
                          assign mobile_image = block.settings.mobile_image | default: desktop_image
                        -%}
                        <picture>
                          {%- if block.settings.mobile_image != blank -%}
                            <source media="(max-width: 749px)" srcset="{{ mobile_image | image_url: width: 300 }}">
                          {%- endif -%}
                          <img
                            src="{{ desktop_image | image_url: width: 400 }}"
                            alt="{{ block.settings.title | default: desktop_image.alt | escape }}"
                            width="{{ desktop_image.width }}"
                            height="{{ desktop_image.height }}"
                            loading="lazy"
                            class="collections-listing-horizontal-image"
                          >
                        </picture>
                      {%- else -%}
                        {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg collections-listing-horizontal-image' }}
                      {%- endif -%}
                    </div>
                  {%- else -%}
                    <div class="collections-listing-image-wrapper">
                      {%- if block.settings.image != blank -%}
                        {%- liquid
                          assign desktop_image = block.settings.image
                          assign mobile_image = block.settings.mobile_image | default: desktop_image
                        -%}
                        <picture>
                          {%- if block.settings.mobile_image != blank -%}
                            <source media="(max-width: 749px)" srcset="{{ mobile_image | image_url: width: 750 }}">
                          {%- endif -%}
                          <img
                            src="{{ desktop_image | image_url: width: 1200 }}"
                            alt="{{ block.settings.title | default: desktop_image.alt | escape }}"
                            width="{{ desktop_image.width }}"
                            height="{{ desktop_image.height }}"
                            loading="lazy"
                            class="collections-listing-image"
                          >
                        </picture>
                      {%- else -%}
                        {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg collections-listing-image' }}
                      {%- endif -%}
                    </div>

                    {%- if block.settings.title != blank -%}
                      <h3 class="collections-listing-title" style="color: {{ section.settings.title_color | default: '#00237d' }} !important;">{{ block.settings.title | escape }}</h3>
                    {%- endif -%}
                  {%- endif -%}

                {%- if block.settings.link != blank -%}
                  </a>
                {%- else -%}
                  </div>
                {%- endif -%}
              </div>
            {% endif %}
          {%- endfor -%}
        </div>
      </div>

      {% if section.settings.show_arrows and section.blocks.size > 0 %}
        <div class="swiper-button-prev-{{ section.id }} swiper-button-prev"></div>
        <div class="swiper-button-next-{{ section.id }} swiper-button-next"></div>
      {% endif %}
    </div>
  </div>
</div>

<script>
  function loadSwiperAndInitCollections{{ section.id | replace: '-', '_' }}() {
    const init = () => {
      new Swiper('.swiper-container-{{ section.id }}', {
        slidesPerView: {{ section.settings.slides_per_view_mobile | default: 1.5 }},
        spaceBetween: 16,
        grabCursor: true,
        breakpoints: {
          750: {
            slidesPerView: {{ section.settings.slides_per_view_desktop | default: 3 }},
            spaceBetween: 32
          }
        }
        {% if section.settings.show_arrows %},
        navigation: {
          nextEl: '.swiper-button-next-{{ section.id }}',
          prevEl: '.swiper-button-prev-{{ section.id }}',
        }
        {% endif %}
      });
    };

    if (typeof Swiper !== 'undefined') {
      init();
    } else {
      const script = document.createElement('script');
      script.src = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js';
      script.onload = init;
      document.head.appendChild(script);
    }
  }

  document.addEventListener('DOMContentLoaded', loadSwiperAndInitCollections{{ section.id | replace: '-', '_' }});
  
  document.addEventListener('shopify:section:load', function(event) {
    if (event.detail.sectionId === '{{ section.id }}') {
      loadSwiperAndInitCollections{{ section.id | replace: '-', '_' }}();
    }
  });
</script>

{% schema %}
{
  "name": "Collections Listing",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Heading Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Top Categories"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "listing_type",
      "label": "Layout Style",
      "options": [
        {
          "value": "normal",
          "label": "Normal Grid/Slider (Vertical)"
        },
        {
          "value": "text_image",
          "label": "Horizontal Cards (Text Left, Image Right)"
        }
      ],
      "default": "normal"
    },
    {
      "type": "header",
      "content": "Card Settings"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image Ratio",
      "options": [
        {
          "value": "square",
          "label": "Square (1:1)"
        },
        {
          "value": "portrait",
          "label": "Portrait (4:5)"
        },
        {
          "value": "landscape",
          "label": "Landscape (16:9)"
        },
        {
          "value": "adapt",
          "label": "Adapt to Image"
        }
      ],
      "default": "square"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#00237d"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Image Border Radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Carousel Settings"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show Navigation Arrows",
      "default": false
    },
    {
      "type": "range",
      "id": "slides_per_view_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Desktop Slides Per View",
      "default": 3
    },

    {
      "type": "select",
      "id": "slides_per_view_mobile",
      "label": "Mobile Slides Per View",
      "options": [
        {
          "value": "1",
          "label": "1 Slide"
        },
        {
          "value": "1.2",
          "label": "1.2 Slides"
        },
        {
          "value": "1.5",
          "label": "1.5 Slides"
        },
        {
          "value": "2",
          "label": "2 Slides"
        },
        {
          "value": "2.2",
          "label": "2.2 Slides"
        }
      ],
      "default": "1.5"
    },
    {
      "type": "header",
      "content": "Color Scheme"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "collection_item",
      "name": "Collection Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop Image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile Image (Optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category Title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Redirect Link"
        },
        {
          "type": "color",
          "id": "card_bg_color",
          "label": "Card Background Color (Horizontal Style)",
          "default": "#eaeaea"
        },
        {
          "type": "color",
          "id": "card_text_color",
          "label": "Card Text Color (Horizontal Style)",
          "default": "#ffffff"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collections Listing",
      "blocks": [
        {
          "type": "collection_item",
          "settings": {
            "title": "Coffee Tumblers"
          }
        },
        {
          "type": "collection_item",
          "settings": {
            "title": "Travel Bottles"
          }
        },
        {
          "type": "collection_item",
          "settings": {
            "title": "Everyday Carry"
          }
        }
      ]
    }
  ]
}
{% endschema %}
