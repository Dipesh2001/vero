<style>
  .pdp-faq-section {
    padding-top: {{ section.settings.padding_top | default: 40 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 40 }}px;
    background-color: rgb(var(--color-background));
  }
  .pdp-faq-container {
    max-width: 1073px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .pdp-faq-list {
    margin-top: 2rem;
  }
  .pdp-faq-item {
    border-bottom: 1px solid #000000;
  }
  .pdp-faq-details {
    width: 100%;
  }
  .pdp-faq-summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    padding: 2.2rem 0;
    margin: 0;
    user-select: none;
  }
  .pdp-faq-summary::-webkit-details-marker {
    display: none;
  }
  .pdp-faq-question {
    font-family: 'Montserrat', sans-serif;
    font-size: 1.8rem;
    font-weight: 500;
    color: #000000;
    margin: 0;
    line-height: 1.3;
  }
  @media screen and (min-width: 750px) {
    .pdp-faq-question {
      font-size: 2.1rem;
    }
  }
  .pdp-faq-icon {
    position: relative;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-left: 1.5rem;
  }
  .pdp-faq-icon::before,
  .pdp-faq-icon::after {
    content: '';
    position: absolute;
    background-color: #000000;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }
  .pdp-faq-icon::before {
    width: 16px;
    height: 2px;
  }
  .pdp-faq-icon::after {
    width: 2px;
    height: 16px;
  }
  .pdp-faq-details[open] .pdp-faq-icon::after {
    transform: rotate(90deg);
    opacity: 0;
  }
  .pdp-faq-details[open] .pdp-faq-icon::before {
    transform: rotate(180deg);
  }
  .pdp-faq-content {
    font-family: 'Inter', sans-serif;
    font-size: 1.5rem;
    line-height: 1.6;
    color: #454545;
    padding-bottom: 2.2rem;
    margin: 0;
  }
</style>

<div class="pdp-faq-section color-{{ section.settings.color_scheme }} gradient">
  <div class="pdp-faq-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="h1" style="font-family: 'Montserrat', sans-serif; font-weight: 700; color: #00237d; margin: 0 0 2rem 0; text-align: left;">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- liquid
      assign faq_items = product.metafields.custom.faq_list.value
      assign show_onboarding = false
      if faq_items == blank
        assign show_onboarding = true
      endif
    -%}

    <div class="pdp-faq-list">
      {%- if show_onboarding -%}
        <!-- Fallback FAQ 1 -->
        <div class="pdp-faq-item">
          <details class="pdp-faq-details" id="pdp-faq-1">
            <summary class="pdp-faq-summary">
              <span class="pdp-faq-question">Does this bottle is leak proof ?</span>
              <span class="pdp-faq-icon"></span>
            </summary>
            <div class="pdp-faq-content">
              Yes, the bottle is designed with an airtight, vacuum-sealed cap and hypergrip silicone seal that makes it 100% leak-proof and spill-safe during workouts or travel.
            </div>
          </details>
        </div>

        <!-- Fallback FAQ 2 -->
        <div class="pdp-faq-item">
          <details class="pdp-faq-details" id="pdp-faq-2">
            <summary class="pdp-faq-summary">
              <span class="pdp-faq-question">How to clean the bottle ?</span>
              <span class="pdp-faq-icon"></span>
            </summary>
            <div class="pdp-faq-content">
              We recommend hand washing the bottle with warm soapy water and a bottle brush. The lid is top-rack dishwasher safe, but hand washing preserves the double-wall coating and paint finishes.
            </div>
          </details>
        </div>

        <!-- Fallback FAQ 3 -->
        <div class="pdp-faq-item">
          <details class="pdp-faq-details" id="pdp-faq-3">
            <summary class="pdp-faq-summary">
              <span class="pdp-faq-question">Is this bottle of stainless steal material ?</span>
              <span class="pdp-faq-icon"></span>
            </summary>
            <div class="pdp-faq-content">
              Yes! The bottle is crafted from premium 18/8 food-grade double-wall vacuum insulated stainless steel, ensuring your drinks stay ice-cold for up to 24 hours or hot for up to 12 hours.
            </div>
          </details>
        </div>

      {%- else -%}
        {%- for item in faq_items -%}
          {%- if item.question != blank and item.answer != blank -%}
            <div class="pdp-faq-item">
              <details class="pdp-faq-details" id="pdp-faq-{{ forloop.index }}">
                <summary class="pdp-faq-summary">
                  <span class="pdp-faq-question">{{ item.question | escape }}</span>
                  <span class="pdp-faq-icon"></span>
                </summary>
                <div class="pdp-faq-content">
                  {{ item.answer | escape }}
                </div>
              </details>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "PDP FAQs Accordion",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-7"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "PDP FAQs Accordion"
    }
  ]
}
{% endschema %}
