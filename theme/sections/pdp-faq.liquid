<style>
  .pdp-faq-section {
    padding-top: {{ section.settings.padding_top | default: 40 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 40 }}px;
    background-color: rgb(var(--color-background));
  }
  .pdp-faq-section .carousel__header {
    text-align: {{ section.settings.heading_alignment | default: 'center' }};
    margin-bottom: 3rem;
  }
  .pdp-faq-section .carousel__header h2 {
    font-family: var(--font-body-custom), 'Montserrat', sans-serif;
    font-weight: 700;
    font-size: 2.8rem;
    color: {{ section.settings.heading_color | default: '#ffc357' }} !important;
    margin: 0;
    line-height: 1.2;
  }
  @media screen and (min-width: 750px) {
    .pdp-faq-section .carousel__header h2 {
      font-size: 4rem;
    }
  }
  .pdp-faq-container {
    max-width: 1073px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .pdp-faq-list {
    margin-top: 2rem;
  }
  .pdp-faq-item {
    border-bottom: 1px solid #000000;
  }
  .pdp-faq-details {
    width: 100%;
  }
  .pdp-faq-summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    padding: 2.2rem 0;
    margin: 0;
    user-select: none;
  }
  .pdp-faq-summary::-webkit-details-marker {
    display: none;
  }
  .pdp-faq-question {
    font-family: 'Montserrat', sans-serif;
    font-size: 1.8rem;
    font-weight: 500;
    color: #000000;
    margin: 0;
    line-height: 1.3;
  }
  @media screen and (min-width: 750px) {
    .pdp-faq-question {
      font-size: 2.1rem;
    }
  }
  .pdp-faq-icon {
    position: relative;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-left: 1.5rem;
  }
  .pdp-faq-icon::before,
  .pdp-faq-icon::after {
    content: '';
    position: absolute;
    background-color: #000000;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }
  .pdp-faq-icon::before {
    width: 16px;
    height: 2px;
  }
  .pdp-faq-icon::after {
    width: 2px;
    height: 16px;
  }
  .pdp-faq-details[open] .pdp-faq-icon::after {
    transform: rotate(90deg);
    opacity: 0;
  }
  .pdp-faq-details[open] .pdp-faq-icon::before {
    transform: rotate(180deg);
  }
  .pdp-faq-content {
    font-family: 'Inter', sans-serif;
    font-size: 1.5rem;
    line-height: 1.6;
    color: #454545;
    padding-bottom: 2.2rem;
    margin: 0;
  }
</style>

<div class="pdp-faq-section color-{{ section.settings.color_scheme }} gradient">
  <div class="pdp-faq-container">
    {%- if section.settings.heading != blank -%}
      <div class="carousel__header">
        <h2>{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}

    <div class="pdp-faq-list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'faq_item' -%}
          {%- assign content_has_data = false -%}
          {%- if block.settings.content != blank -%}
            {%- assign content_has_data = true -%}
          {%- endif -%}

          {%- if content_has_data and block.settings.heading != blank -%}
            <div class="pdp-faq-item" {{ block.shopify_attributes }}>
              <details class="pdp-faq-details" id="pdp-faq-{{ block.id }}">
                <summary class="pdp-faq-summary">
                  <span class="pdp-faq-question">{{ block.settings.heading | escape }}</span>
                  <span class="pdp-faq-icon"></span>
                </summary>
                <div class="pdp-faq-content">
                  {{ block.settings.content }}
                </div>
              </details>
            </div>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "PDP FAQs Accordion",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#ffc357"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "center"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-7"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "FAQ Question",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "content",
          "default": "<p>FAQ Answer content.</p>",
          "label": "Content"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PDP FAQs Accordion",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "heading": "Does this bottle is leak proof ?",
            "content": "<p>Yes, the bottle is designed with an airtight, vacuum-sealed cap and hypergrip silicone seal that makes it 100% leak-proof and spill-safe during workouts or travel.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "heading": "How to clean the bottle ?",
            "content": "<p>We recommend hand washing the bottle with warm soapy water and a bottle brush. The lid is top-rack dishwasher safe, but hand washing preserves the double-wall coating and paint finishes.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "heading": "Is this bottle of stainless steal material ?",
            "content": "<p>Yes! The bottle is crafted from premium 18/8 food-grade double-wall vacuum insulated stainless steel, ensuring your drinks stay ice-cold for up to 24 hours or hot for up to 12 hours.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
