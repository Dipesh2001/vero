<product-info
  id="MainProduct-{{ section.id }}"
  class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
  {% if section.settings.image_zoom == 'hover' %}
    data-zoom-on-hover
  {% endif %}
>
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
  {{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer="defer"></script>
  <style>
    /* Desktop 50/50 layout overrides */
    @media screen and (min-width: 990px) {
      .product:not(.product--no-media) .product__media-wrapper {
        max-width: 50% !important;
        width: calc(50% - var(--grid-desktop-horizontal-spacing) / 2) !important;
        position: sticky !important;
        top: 3rem !important;
        height: fit-content !important;
        align-self: start !important;
      }
      .product:not(.product--no-media) .product__info-wrapper {
        max-width: 50% !important;
        width: calc(50% - var(--grid-desktop-horizontal-spacing) / 2) !important;
        padding-left: 5rem !important;
      }
    }

    /* Custom PDP Swiper Gallery */
    .pdp-gallery-wrapper {
      position: relative;
      width: 100%;
    }
    .pdp-gallery-main {
      width: 100% !important;
      max-width: 100% !important;
      margin: 0 auto !important;
      aspect-ratio: 1 / 1 !important;
      background-color: transparent !important;
      border: none !important;
      border-radius: 0 !important;
      overflow: hidden !important;
      position: relative !important;
      padding: 0 !important;
    }
    .pdp-gallery-main .swiper-slide {
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      width: 100% !important;
      height: 100% !important;
      padding: 0 80px !important;
      box-sizing: border-box !important;
    }
    .pdp-gallery-main img {
      max-width: 100% !important;
      max-height: 100% !important;
      object-fit: contain !important;
      display: block !important;
    }
    .pdp-gallery-main .pdp-media-non-image {
      width: 100% !important;
      height: 100% !important;
      object-fit: contain !important;
      padding: 0 60px !important;
      box-sizing: border-box !important;
    }
    .pdp-gallery-thumbs {
      width: 100%;
      max-width: 423px;
      margin: 15px auto 0 auto;
      overflow: hidden;
    }
    .pdp-gallery-thumbs .swiper-wrapper {
      display: flex;
      flex-direction: row;
    }
    .pdp-gallery-thumbs .swiper-slide {
      aspect-ratio: 89 / 112;
      height: auto;
      background-color: transparent !important;
      border: none !important;
      border-radius: 0 !important;
      cursor: pointer;
      opacity: 0.5;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      flex-shrink: 0;
      transition: opacity 0.2s;
    }
    .pdp-gallery-thumbs .swiper-slide-thumb-active {
      opacity: 1 !important;
    }
    .pdp-gallery-thumbs img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
    
    /* Wishlist Icon Overlay */
    .pdp-gallery-main .pdp-wishlist-icon {
      position: absolute;
      top: 15px;
      right: 15px;
      z-index: 10;
      width: 37px;
      height: 37px;
      background: rgb(var(--color-background));
      border-radius: 50%;
      display: none; /* Kept hidden as requested */
      align-items: center;
      justify-content: center;
      box-shadow: 0 2px 5px rgba(0,0,0,0.1);
      cursor: pointer;
    }

    /* Variant fieldset border boxes */
    fieldset.product-form__input {
      border: 1px solid rgba(var(--color-foreground), 0.15) !important;
      border-radius: 10px !important;
      padding: 2.5rem 2rem 2rem 2rem !important;
      margin: 3rem 0 !important;
      position: relative !important;
      overflow: visible !important;
      display: block !important;
    }
    fieldset.product-form__input legend.form__label {
      background-color: var(--color-brand-secondary, #C8E8FB) !important;
      color: rgb(var(--color-foreground)) !important;
      font-family: 'Inter', sans-serif !important;
      font-size: 1.3rem !important;
      font-weight: 500 !important;
      padding: 3px 12px !important;
      border-radius: 6px !important;
      position: absolute !important;
      top: -12px !important;
      left: 15px !important;
      margin: 0 !important;
      transform: none !important;
      width: auto !important;
      display: inline-block !important;
      float: none !important;
    }

    /* Radio button custom styling — accessible, mobile-bulletproof hiding */
    fieldset.product-form__input input[type="radio"] {
      position: absolute !important;
      opacity: 0 !important;
      width: 1px !important;
      height: 1px !important;
      margin: -1px !important;
      padding: 0 !important;
      overflow: hidden !important;
      clip: rect(0, 0, 0, 0) !important;
      border: 0 !important;
    }
    .product-form__input--pill input[type="radio"] + label {
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      min-width: 50px !important;
      height: 50px !important;
      padding: 0 15px !important;
      border: 1px solid rgba(var(--color-button), 0.15) !important;
      border-radius: 4px !important;
      background-color: transparent !important;
      color: rgba(var(--color-button), 0.15) !important;
      font-family: 'Public Sans', sans-serif !important;
      font-size: 1.6rem !important;
      font-weight: 600 !important;
      cursor: pointer !important;
      text-align: center !important;
      transition: background-color 0.2s, border-color 0.2s, color 0.2s !important;
      margin-right: 10px !important;
      margin-bottom: 10px !important;
    }
    .product-form__input--pill input[type="radio"]:checked + label {
      background-color: transparent !important;
      border-color: rgb(var(--color-button)) !important;
      color: rgb(var(--color-button)) !important;
    }

    /* Quantity Selector Styling */
    .product-form__quantity {
      display: flex !important;
      align-items: center !important;
      gap: 15px !important;
      margin: 3rem 0 !important;
    }
    .product-form__quantity .quantity__label {
      font-family: 'Poppins', sans-serif !important;
      font-size: 2rem !important;
      font-weight: 400 !important;
      color: rgb(var(--color-foreground)) !important;
      margin: 0 !important;
    }
    .product-form__quantity quantity-input.quantity {
      width: 120px !important;
      height: 44px !important;
      background-color: rgb(var(--color-button)) !important;
      border: none !important;
      border-radius: 8px !important;
      padding: 0 !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: space-between !important;
      overflow: hidden !important;
    }
    .product-form__quantity .quantity__button {
      width: 35px !important;
      height: 100% !important;
      background: none !important;
      border: none !important;
      color: #d9d9d9 !important;
      font-family: 'Poppins', sans-serif !important;
      font-size: 2rem !important;
      cursor: pointer !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      padding: 0 !important;
    }
    .product-form__quantity .quantity__button svg {
      width: 12px !important;
      height: 12px !important;
      stroke: #d9d9d9 !important;
      fill: #d9d9d9 !important;
    }
    .product-form__quantity .quantity__input {
      background: none !important;
      border: none !important;
      color: #ffffff !important;
      font-family: 'Poppins', sans-serif !important;
      font-size: 2rem !important;
      font-weight: 500 !important;
      width: 40px !important;
      height: 100% !important;
      text-align: center !important;
      padding: 0 !important;
    }
    .product-form__quantity .quantity__input::-webkit-outer-spin-button,
    .product-form__quantity .quantity__input::-webkit-inner-spin-button {
      -webkit-appearance: none !important;
      margin: 0 !important;
    }

    /* Side-by-side buy buttons container */
    .product-form__buttons {
      display: flex !important;
      flex-direction: row !important;
      gap: 20px !important;
      align-items: center !important;
      margin: 3rem 0 !important;
      width: 100% !important;
    }
    .product-form__buttons > * {
      flex: 1 !important;
      margin: 0 !important;
      width: auto !important;
      max-width: 100% !important;
    }
    .product-form__submit {
      height: 60px !important;
      background-color: rgb(var(--color-button)) !important;
      border: none !important;
      border-radius: 4px !important;
      color: rgb(var(--color-button-text)) !important;
      font-family: 'Poppins', sans-serif !important;
      font-size: 2rem !important;
      font-weight: 600 !important;
      text-transform: uppercase !important;
    }
    .product-form__submit:hover {
      background-color: rgb(var(--color-button)) !important;
      opacity: 0.9 !important;
    }
    .product-form__submit[disabled] {
      height: 60px !important;
      background-color: #f2eadf !important;
      border: 1px solid #c4c4c4 !important;
      border-radius: 4px !important;
      color: #868686 !important;
      font-family: 'Poppins', sans-serif !important;
      font-size: 2rem !important;
      font-weight: 600 !important;
      text-transform: uppercase !important;
      cursor: not-allowed !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      width: auto !important;
      flex: 1 !important;
    }
    .product-form__buynow {
      height: 60px !important;
      background-color: {{ section.settings.accent_color | default: '#ffc357' }} !important;
      border: 1px solid rgb(var(--color-button)) !important;
      border-radius: 4px !important;
      color: {{ section.settings.accent_text_color | default: 'rgb(var(--color-button))' }} !important;
      font-family: 'Poppins', sans-serif !important;
      font-size: 2rem !important;
      font-weight: 600 !important;
      text-transform: uppercase !important;
      cursor: pointer !important;
      display: inline-flex !important;
      align-items: center;
      justify-content: center;
    }
    .product-form__buynow:hover {
      background-color: {{ section.settings.accent_color | default: '#ffc357' }} !important;
      opacity: 0.9 !important;
    }
    .product-form__buynow[disabled] {
      opacity: 0.5 !important;
      cursor: not-allowed !important;
    }
    .pdp-gallery-main .swiper-button-prev,
    .pdp-gallery-main .swiper-button-next {
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      z-index: 10 !important;
      color: rgb(var(--color-button)) !important;
      background-color: transparent !important;
      background: none !important;
      width: 44px !important;
      height: 44px !important;
      border-radius: 0 !important;
      box-shadow: none !important;
      top: 50% !important;
      margin-top: 0 !important;
      transform: translateY(-50%) !important;
    }
    .pdp-gallery-main .swiper-button-prev {
      left: 20px !important;
    }
    .pdp-gallery-main .swiper-button-next {
      right: 20px !important;
    }
    .pdp-gallery-main .swiper-button-prev::after,
    .pdp-gallery-main .swiper-button-next::after {
      font-size: 38px !important;
      font-weight: bold !important;
    }

    /* Icon with Text - Bordered Table View matching Figma */
    .product__info-container .icon-with-text--horizontal.icon-with-text--bordered {
      display: flex !important;
      flex-direction: row !important;
      width: 100% !important;
      border: 1px solid rgba(var(--color-foreground), 0.15) !important;
      border-radius: 5px !important;
      background-color: transparent !important;
      padding: 0 !important;
      margin: 3rem 0 !important;
      gap: 0 !important;
    }
    .product__info-container .icon-with-text--horizontal.icon-with-text--bordered .icon-with-text__item {
      flex-direction: row !important;
      justify-content: center !important;
      align-items: center !important;
      gap: 0.8rem !important;
      padding: 1.5rem 1rem !important;
      width: 33.33% !important;
      border-right: 1px solid rgba(var(--color-foreground), 0.15) !important;
      margin: 0 !important;
      flex: 1 !important;
      box-sizing: border-box !important;
    }
    .product__info-container .icon-with-text--horizontal.icon-with-text--bordered .icon-with-text__item:last-child {
      border-right: none !important;
    }
    .product__info-container .icon-with-text--horizontal.icon-with-text--bordered .icon-with-text__item span {
      display: -webkit-box !important;
      -webkit-line-clamp: 2 !important;
      -webkit-box-orient: vertical !important;
      overflow: hidden !important;
      text-overflow: ellipsis !important;
      white-space: normal !important;
      line-height: 1.3 !important;
      font-size: 1.4rem !important;
      text-align: center !important;
    }
    .product__info-container .icon-with-text--horizontal.icon-with-text--bordered .svg-wrapper,
    .product__info-container .icon-with-text--horizontal.icon-with-text--bordered img {
      margin-bottom: 0 !important;
      margin-right: 0.5rem !important;
      width: 2rem !important;
      height: 2rem !important;
      flex-shrink: 0 !important;
    }

    /* Icon with Text - Dotted connected View matching Figma */
    .product__info-container .icon-with-text--horizontal.icon-with-text--dotted {
      display: flex !important;
      flex-direction: row !important;
      justify-content: center !important;
      align-items: center !important;
      width: 100% !important;
      border: none !important;
      background-color: transparent !important;
      padding: 0 !important;
      margin: 2rem 0 !important;
      gap: 1.5rem !important;
    }
    .product__info-container .icon-with-text--horizontal.icon-with-text--dotted .icon-with-text__item {
      display: inline-flex !important;
      flex-direction: row !important;
      align-items: center !important;
      justify-content: center !important;
      border-right: none !important;
      margin: 0 !important;
      padding: 0 !important;
      flex: 0 0 auto !important;
      box-sizing: border-box !important;
      gap: 0.8rem !important;
    }
    .product__info-container .icon-with-text--horizontal.icon-with-text--dotted .icon-with-text__item span {
      line-height: 1.3 !important;
      font-size: 1.4rem !important;
      text-align: center !important;
    }
    .product__info-container .icon-with-text--horizontal.icon-with-text--dotted .icon-with-text__item:not(:last-child)::after {
      content: "·" !important;
      margin-left: 1.5rem !important;
      font-size: 1.6rem !important;
      color: rgba(var(--color-foreground), 0.5) !important;
      pointer-events: none;
    }
    .product__info-container .icon-with-text--horizontal.icon-with-text--dotted .svg-wrapper,
    .product__info-container .icon-with-text--horizontal.icon-with-text--dotted img {
      margin-bottom: 0 !important;
      margin-right: 0.5rem !important;
      width: 2rem !important;
      height: 2rem !important;
      flex-shrink: 0 !important;
    }

    /* Cleaned up inline styles selectors */
    .product-form__submit, .product-form__buynow {
      border: none !important;
      border-radius: 4px !important;
    }
    .product-form__submit::after, .product-form__buynow::after,
    .product-form__submit::before, .product-form__buynow::before {
      display: none !important;
    }
    .product__text {
      color: var(--text-color) !important;
      font-size: var(--font-size) !important;
    }
    .product__title h1 {
      font-family: var(--font-heading) !important;
      font-size: 3.6rem !important;
      font-weight: 600 !important;
      color: var(--color-brand-primary) !important;
      margin: 0 !important;
      line-height: 1.2 !important;
    }
    .product__title .product__subtitle {
      font-family: var(--font-body) !important;
      font-size: 2rem !important;
      font-weight: 400 !important;
      color: var(--color-text-secondary) !important;
      margin: 1rem 0 0 0 !important;
      line-height: 1.4 !important;
    }
    .pdp-price-wrapper {
      margin-top: 1.5rem !important;
      margin-bottom: 1.5rem !important;
    }
    .pdp-price-inner-flex {
      display: flex !important;
      align-items: center !important;
      gap: 15px !important;
      font-family: var(--font-body) !important;
    }
    .pdp-price-current {
      font-size: 3.2rem !important;
      font-weight: 500 !important;
      color: var(--color-brand-primary) !important;
    }
    .pdp-price-compare {
      font-size: 3.2rem !important;
      font-weight: 400 !important;
      color: rgba(var(--color-foreground), 0.2) !important;
      text-decoration: line-through !important;
    }
    .pdp-price-discount {
      font-size: 2.2rem !important;
      font-weight: 500 !important;
      color: var(--color-brand-accent) !important;
    }
    .pdp-price-tax-notice,
    .pdp-price-tax-notice p,
    .pdp-price-tax-notice h1,
    .pdp-price-tax-notice h2,
    .pdp-price-tax-notice h3,
    .pdp-price-tax-notice h4,
    .pdp-price-tax-notice h5,
    .pdp-price-tax-notice h6 {
      font-family: var(--font-body) !important;
      font-size: 1.8rem !important;
      font-weight: 500 !important;
      color: var(--color-text-secondary) !important;
      margin: 0 !important;
      margin-top: 0.5rem !important;
      line-height: 1.6 !important;
    }
    .pdp-price-tax-notice strong,
    .pdp-price-tax-notice b {
      font-weight: 600 !important;
      color: var(--color-text-secondary) !important;
    }
    .product__tax.caption {
      margin-top: -1rem !important;
      margin-bottom: 1.5rem !important;
    }
    .pdp-inventory-status--low {
      color: rgb(238, 148, 65) !important;
    }
    .pdp-inventory-status--in {
      color: rgb(62, 214, 96) !important;
    }
    .pdp-inventory-status--out {
      color: rgb(200, 200, 200) !important;
    }
    .product-payment-icons {
      margin: 2.5rem 0 !important;
    }
    .product-payment-image {
      max-width: var(--max-width, 100%) !important;
      width: 100% !important;
      height: auto !important;
      display: block !important;
    }

    /* =============================================
       MOBILE RESPONSIVE — matches Figma 375px spec
       ============================================= */
    /* =============================================
       MOBILE RESPONSIVE — matches Figma 375px spec
       ============================================= */
    @media screen and (max-width: 749px) {
      /* Full-width single column layout */
      .product.grid--2-col-tablet {
        display: flex !important;
        flex-direction: column !important;
        grid-template-columns: 1fr !important;
      }
      .product__media-wrapper,
      .product__info-wrapper {
        max-width: 100% !important;
        width: 100% !important;
        flex: 0 0 100% !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
      }
      /* Sticky only on desktop */
      .product__column-sticky {
        position: relative !important;
        top: auto !important;
        height: auto !important;
      }

      /* Gallery: main image 1:1 ratio for mobile, full screen width with no padding */
      .pdp-gallery-main {
        aspect-ratio: 1 / 1 !important;
        border-radius: 0 !important;
      }
      .pdp-gallery-main .swiper-slide {
        padding: 0 !important;
      }
      .pdp-gallery-main img {
        width: 100% !important;
        height: 100% !important;
        object-fit: cover !important;
      }
      /* Hide arrows on mobile gallery per Figma */
      .pdp-gallery-main .swiper-button-prev,
      .pdp-gallery-main .swiper-button-next {
        display: none !important;
      }
      /* Thumbs strip: slightly smaller padding on mobile */
      .pdp-gallery-thumbs {
        max-width: 100% !important;
        margin-top: 10px !important;
        padding: 0 1.5rem !important;
      }

      /* Title: smaller font on mobile matching Figma 30px / 12px */
      .product__title h1 {
        font-family: 'Public Sans', sans-serif !important;
        font-size: 3.0rem !important;
        font-weight: 600 !important;
        line-height: 44px !important;
        color: #00237d !important;
        margin-top: 0 !important;
        margin-bottom: 0px !important;
      }
      .product__title .product__subtitle,
      .product__text.caption-with-letter-spacing {
        font-family: 'Public Sans', sans-serif !important;
        font-size: 1.2rem !important;
        font-weight: 400 !important;
        line-height: 44px !important;
        color: #454545 !important;
        margin-top: 0 !important;
        text-transform: none !important;
      }

      /* Price: compact Figma layout 20px / 20px / 15px */
      .pdp-price-current,
      .price__regular .price-item--regular,
      .price__sale .price-item--sale {
        font-family: 'Poppins', sans-serif !important;
        font-weight: 500 !important;
        font-size: 1.6rem !important;
        line-height: 24px !important;
        color: #00237d !important;
      }
      .pdp-price-compare,
      .price__sale .price-item--regular {
        font-family: 'Poppins', sans-serif !important;
        font-weight: 400 !important;
        font-size: 1.6rem !important;
        line-height: 24px !important;
        color: #d9d9d9 !important;
        text-decoration: line-through;
      }
      .pdp-price-discount {
        font-family: 'Poppins', sans-serif !important;
        font-weight: 500 !important;
        font-size: 1.2rem !important;
        line-height: 18px !important;
      }
      .pdp-price-inner-flex {
        gap: 4px !important;
        align-items: center !important;
      }
      .pdp-price-tax-notice,
      .pdp-price-tax-notice p,
      .product__tax {
        font-family: 'Poppins', sans-serif !important;
        font-weight: 500 !important;
        font-size: 8px !important;
        line-height: 12px !important;
        color: #868686 !important;
        margin-top: 0.3rem !important;
      }
      .pdp-price-tax-notice h5 {
        font-family: 'Public Sans', sans-serif !important;
        font-weight: 400 !important;
        font-size: 10px !important;
        line-height: 28px !important;
        color: #868686 !important;
        letter-spacing: -0.4px !important;
      }
      .product__description,
      .product__description p {
        font-family: 'Public Sans', sans-serif !important;
        font-weight: 400 !important;
        font-size: 1.0rem !important;
        line-height: 28px !important;
        color: #868686 !important;
        letter-spacing: -0.4px !important;
      }

      /* Variant fieldsets — tighter padding and spacing */
      fieldset.product-form__input {
        padding: 1.5rem 1rem 1rem 1rem !important;
        margin: 1.5rem 0 !important;
      }
      fieldset.product-form__input legend.form__label {
        font-size: 1.0rem !important;
        padding: 2px 8px !important;
        top: -10px !important;
      }

      /* Size pills on mobile matching Figma 54x27px and 10px font */
      .product-form__input--pill input[type="radio"] + label {
        font-family: 'Inter', sans-serif !important;
        font-weight: 400 !important;
        min-width: 54px !important;
        height: 27px !important;
        font-size: 1.0rem !important;
        line-height: 15px !important;
        padding: 0 8px !important;
        margin-right: 6px !important;
        margin-bottom: 6px !important;
        border-radius: 4px !important;
      }

      /* Swatch size override on mobile matching Figma 21x21px */
      .product-form__input--swatch .swatch-input__input + .swatch-input__label {
        --swatch-input--size: 2.1rem !important;
        margin: 0 8px 8px 0 !important;
      }

      /* Quantity selector */
      .product-form__quantity {
        gap: 10px !important;
        margin: 1.5rem 0 !important;
      }
      .product-form__quantity .quantity__label {
        font-family: 'Poppins', sans-serif !important;
        font-weight: 400 !important;
        font-size: 1.0rem !important;
        line-height: 15px !important;
        color: #454545 !important;
      }
      .quantity {
        width: 64px !important;
        min-height: 18px !important;
        height: 18px !important;
        background-color: #00237d !important;
        border-radius: 8px !important;
        border: none !important;
      }
      .quantity__button {
        width: 20px !important;
        color: #d9d9d9 !important;
      }
      .quantity__button svg {
        fill: #d9d9d9 !important;
        stroke: #d9d9d9 !important;
        width: 10px !important;
        height: 10px !important;
      }
      .quantity__input {
        font-family: 'Poppins', sans-serif !important;
        font-size: 1.0rem !important;
        color: #d9d9d9 !important;
      }

      /* Side by side buttons, height 39px per Figma mobile, equal size */
      .product-form__buttons {
        display: flex !important;
        flex-direction: row !important;
        gap: 10px !important;
        margin: 1.5rem 0 !important;
      }
      .product-form__submit,
      .product-form__buynow,
      .product-form__submit[disabled] {
        height: 39px !important;
        font-size: 1.0rem !important;
        border-radius: 4px !important;
        flex: 1 !important;
        padding: 0 0.5rem !important;
        white-space: nowrap !important;
        letter-spacing: 0 !important;
      }

      /* Icon-with-text stays 3-col but tighter */
      .product__info-container .icon-with-text--horizontal.icon-with-text--bordered {
        margin: 1.5rem 0 !important;
        border: none !important;
      }
      .product__info-container .icon-with-text--horizontal.icon-with-text--bordered .icon-with-text__item {
        padding: 1rem 0.5rem !important;
      }
      .product__info-container .icon-with-text--horizontal.icon-with-text--bordered .icon-with-text__item span {
        font-size: 1.1rem !important;
        -webkit-line-clamp: 2 !important;
      }

      .product__info-container .icon-with-text--horizontal.icon-with-text--dotted {
        margin: 1rem 0 !important;
        gap: 0.8rem !important;
      }
      .product__info-container .icon-with-text--horizontal.icon-with-text--dotted .icon-with-text__item span {
        font-size: 1.1rem !important;
      }
      .product__info-container .icon-with-text--horizontal.icon-with-text--dotted .icon-with-text__item:not(:last-child)::after {
        margin-left: 0.8rem !important;
      }

      /* Payment image smaller on mobile */
      .product-payment-image {
        max-width: 220px !important;
        margin: 0 auto !important;
      }

      /* Section padding tighter on mobile */
      .section-{{ section.id }}-padding {
        padding-left: 1.5rem !important;
        padding-right: 1.5rem !important;
      }

      /* Info wrapper padding */
      .product__info-container {
        padding: 0 1.5rem !important; /* give content some padding so it doesn't touch the screen edge */
      }
    }
  </style>
  {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
