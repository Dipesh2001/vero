    <script type="application/ld+json">
      {{ product | structured_data }}
    </script>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const initGallery = () => {
          if (typeof Swiper === 'undefined') {
            setTimeout(initGallery, 50);
            return;
          }

          let mainSwiper = null;
          let thumbsSwiper = null;

          // 1. Store memory references to all original slides in the main and thumb galleries
          const allMainSlides = Array.from(document.querySelectorAll('.pdp-gallery-main .swiper-slide'));
          const allThumbSlides = Array.from(document.querySelectorAll('.pdp-gallery-thumbs .swiper-slide'));

          // 2. Color option position mapping from Liquid
          const productOptionNames = "{{ product.options | join: '|' }}".split('|');
          const colorOptionIndex = productOptionNames.findIndex(o => {
            const name = o.toLowerCase().trim();
            return name === 'color' || name === 'colour';
          });
          console.log('[Gallery] Color option index:', colorOptionIndex, '| Options:', productOptionNames);

          // 3. Gathering all color option values from Liquid dynamically
          const allColors = [];
          {%- for option in product.options_with_values -%}
            {%- assign downcased_opt = option.name | downcase -%}
            {%- if downcased_opt == 'color' or downcased_opt == 'colour' -%}
            {%- for value in option.values -%}
              allColors.push({{ value | json }}.toLowerCase().trim());
            {%- endfor -%}
          {%- endif -%}{%- endfor -%}
          console.log('[Gallery] All product colors:', allColors);

          // 4. Dynamic Slide Filter Function
          function filterGalleryByColor(colorValue) {
            try {
              if (colorOptionIndex < 0 || !colorValue) return;
              const lowerColor = colorValue.toLowerCase().trim();
              console.log('[Gallery] Filtering gallery for color:', lowerColor);

              // A. Destroy existing Swiper instances to prevent indexing crashes
              if (mainSwiper && typeof mainSwiper.destroy === 'function') {
                try { mainSwiper.destroy(true, true); } catch(e) {}
                mainSwiper = null;
              }
              if (thumbsSwiper && typeof thumbsSwiper.destroy === 'function') {
                try { thumbsSwiper.destroy(true, true); } catch(e) {}
                thumbsSwiper = null;
              }

              const mainWrapper = document.querySelector('.pdp-gallery-main .swiper-wrapper');
              const thumbsWrapper = document.querySelector('.pdp-gallery-thumbs .swiper-wrapper');
              if (!mainWrapper || !thumbsWrapper) return;

              // B. Clear current slides from DOM
              mainWrapper.innerHTML = '';
              thumbsWrapper.innerHTML = '';
              
              // D. Filter Logic
              let matchCount = 0;
              allMainSlides.forEach((slide, index) => {
                const imgEl = slide.querySelector('img');
                const slideAlt = imgEl ? (imgEl.getAttribute('alt') || '').toLowerCase().trim() : '';
                const slideColor = slide.getAttribute('data-color-value');
                
                let isMatch = false;
                
                if (slideColor) {
                  // Use robust metafield tagging logic if available
                  isMatch = (slideColor === lowerColor || slideColor === 'common');
                } else {
                  // Fallback to legacy alt-text logic
                  const isSelectedColor = slideAlt === lowerColor || slideAlt.includes(lowerColor);
                  let isOtherColor = false;
                  allColors.forEach(col => {
                    if (col !== lowerColor && (slideAlt === col || slideAlt.includes(col))) {
                      isOtherColor = true;
                    }
                  });
                  isMatch = isSelectedColor || !isOtherColor;
                }

                if (isMatch) {
                  // Clone slides to keep original memory reference pristine
                  const mainClone = slide.cloneNode(true);
                  mainWrapper.appendChild(mainClone);
                  const thumbSlide = allThumbSlides[index];
                  if (thumbSlide) {
                    const thumbClone = thumbSlide.cloneNode(true);
                    thumbsWrapper.appendChild(thumbClone);
                  }
                  matchCount++;
                }
              });

              console.log('[Gallery] Filtered. Matches found:', matchCount);

              // Fallback: If no slides match, show all slides
              if (matchCount === 0) {
                allMainSlides.forEach((slide, index) => {
                  const mainClone = slide.cloneNode(true);
                  mainWrapper.appendChild(mainClone);
                  const thumbSlide = allThumbSlides[index];
                  if (thumbSlide) {
                    const thumbClone = thumbSlide.cloneNode(true);
                    thumbsWrapper.appendChild(thumbClone);
                  }
                });
              }

              // C. Re-initialize Swiper instances fresh
              thumbsSwiper = new Swiper('.pdp-gallery-thumbs', {
                spaceBetween: 23,
                slidesPerView: 4,
                watchSlidesProgress: true,
                centerInsufficientSlides: true,
                loop: false
              });

              mainSwiper = new Swiper('.pdp-gallery-main', {
                spaceBetween: 10,
                {%- if section.settings.show_arrows -%}
                navigation: {
                  nextEl: '.pdp-gallery-main .swiper-button-next',
                  prevEl: '.pdp-gallery-main .swiper-button-prev',
                },
                {%- endif -%}
                thumbs: {
                  swiper: thumbsSwiper,
                },
                loop: false,
              });
            } catch (error) {
              console.error('[Gallery] Swiper filtering failed safely:', error);
            }
          }

          {%- assign color_option_value = '' -%}
          {%- for option in product.options -%}
            {%- assign downcased_opt = option | downcase -%}
            {%- if downcased_opt == 'color' or downcased_opt == 'colour' -%}
              {%- if forloop.index == 1 -%}{%- assign color_option_value = product.selected_or_first_available_variant.option1 -%}
              {%- elsif forloop.index == 2 -%}{%- assign color_option_value = product.selected_or_first_available_variant.option2 -%}
              {%- elsif forloop.index == 3 -%}{%- assign color_option_value = product.selected_or_first_available_variant.option3 -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}

          // 5. Initial filter based on selected variant's color

          if (colorOptionIndex >= 0) {
            const initialColor = {{ color_option_value | json }};
            if (initialColor) {
              filterGalleryByColor(initialColor);
            }
          } else {
            // No color option, initialize swipers normally
            thumbsSwiper = new Swiper('.pdp-gallery-thumbs', {
              spaceBetween: 23,
              slidesPerView: 4,
              watchSlidesProgress: true,
              centerInsufficientSlides: true
            });

            mainSwiper = new Swiper('.pdp-gallery-main', {
              spaceBetween: 10,
              {%- if section.settings.show_arrows -%}
              navigation: {
                nextEl: '.pdp-gallery-main .swiper-button-next',
                prevEl: '.pdp-gallery-main .swiper-button-prev',
              },
              {%- endif -%}
              thumbs: {
                swiper: thumbsSwiper,
              },
              loop: false,
            });
          }

          // 6. Listen for PUB_SUB events to handle color changes robustly across DOM updates
          if (typeof subscribe === 'function' && typeof PUB_SUB_EVENTS !== 'undefined') {
            subscribe(PUB_SUB_EVENTS.optionValueSelectionChange, (event) => {
              const target = event.data?.target;
              if (target && target.tagName === 'INPUT' && target.type === 'radio') {
                const fieldset = target.closest('fieldset');
                if (fieldset) {
                  const legend = fieldset.querySelector('legend');
                  const legendText = legend ? legend.textContent.toLowerCase() : '';
                  if (legendText.includes('color') || legendText.includes('colour')) {
                    console.log('[Gallery] Color change detected via optionValueSelectionChange:', target.value);
                    filterGalleryByColor(target.value);
                  }
                }
              }
            });

            // Also listen to variantChange as a fallback
            subscribe(PUB_SUB_EVENTS.variantChange, (event) => {
              const variant = event.data?.variant;
              if (!variant) return;
              if (colorOptionIndex >= 0) {
                const colorValue = variant['option' + (colorOptionIndex + 1)];
                console.log('[Gallery] PUB_SUB variantChange detected color:', colorValue);
                filterGalleryByColor(colorValue);
              }
            });
          }
        };

        initGallery();
      });
    </script>
  </div>
</product-info>

