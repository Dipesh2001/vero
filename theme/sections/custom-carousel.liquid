{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-slideshow.css' | asset_url | stylesheet_tag }}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

<style>
  /* Base Section Styling */
  .custom-carousel-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile | default: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile | default: 0 }}px;
    position: relative;
    overflow: hidden;
  }
  @media screen and (min-width: 750px) {
    .custom-carousel-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | default: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | default: 0 }}px;
    }
  }

  /* Header Styling - 40px Bold matching Figma */
  .carousel__header {
    text-align: {{ section.settings.heading_alignment | default: 'center' }};
    margin-bottom: 3rem;
  }
  .carousel__header h2 {
    font-family: var(--font-body-custom);
    font-weight: 700;
    font-size: 2.8rem;
    color: rgb(var(--color-foreground)) !important;
    margin: 0;
    line-height: 1.2;
  }
  @media screen and (min-width: 750px) {
    .carousel__header h2 {
      font-size: 4rem; /* 40px */
    }
  }
  
  /* Swiper Wrapper */
  .carousel-wrapper-{{ section.id }} {
    position: relative;
    max-width: 100vw;
  }
  
  {% if section.settings.carousel_type == 'card' %}
    /* Card Layout styling (Figma) */
    .carousel-wrapper-{{ section.id }} {
      position: relative;
      max-width: 1200px;
      margin: 0 auto;
      {% if section.settings.arrow_position == 'outside' %}
        padding: 40px 80px; 
      {% else %}
        padding: 40px 20px;
      {% endif %}
      display: flex;
      justify-content: center;
    }
    
    .swiper-container-{{ section.id }} {
      width: 851px; /* Figma Width */
      height: 434px; /* Figma Height */
      max-width: 100%;
    }
    @media screen and (min-width: 1000px) {
      .swiper-container-{{ section.id }} {
        transform: translateX(-12px); /* Shift left to offset cards stack on right */
      }
    }
    
    .swiper-slide-{{ section.id }} {
      border-radius: 18px; /* Figma Corner Radius */
      overflow: hidden;
      box-shadow: 0 10px 30px rgba(0,0,0,0.1);
      display: flex;
      align-items: center;
      justify-content: center;
      box-sizing: border-box;
      position: relative;
    }

    .slide-background-{{ section.id }} {
      position: absolute;
      top: 0; left: 0; width: 100%; height: 100%; z-index: 1;
    }
    
    @media screen and (max-width: 749px) {
      .swiper-slide-{{ section.id }} {
        height: auto;
      }
      .swiper-container-{{ section.id }} { height: auto; aspect-ratio: 851 / 434; }
    }
    
  {% else %}
    /* Slider Layout specific styling */
    .swiper-container-{{ section.id }} {
      width: 100%;
      height: 60vh;
    }
    @media screen and (min-width: 750px) {
      .swiper-container-{{ section.id }} {
        {% if section.settings.slide_height == 'small' %} height: 50vh;
        {% elsif section.settings.slide_height == 'medium' %} height: 70vh;
        {% elsif section.settings.slide_height == 'large' %} height: 90vh;
        {% else %} height: 60vh; {% endif %}
      }
    }
    .swiper-slide-{{ section.id }} {
      position: relative;
      display: flex;
      justify-content: center;
      align-items: center;
    }
    .slide-background-{{ section.id }} {
      position: absolute;
      top: 0; left: 0; width: 100%; height: 100%; z-index: 1;
    }
    .slide-background-{{ section.id }} img {
      width: 100%; height: 100%; object-fit: cover;
      pointer-events: none; -webkit-user-drag: none;
    }
    .slide-overlay-{{ section.id }} {
      position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 2;
    }
    .slide-content-{{ section.id }} {
      position: relative; z-index: 3; display: flex; flex-direction: column;
      text-align: center; padding: 2rem;
    }
    .slide-content-{{ section.id }} * { pointer-events: auto; }
  {% endif %}

  /* Navigation Arrows - Match Figma Size 35x35 and fix Swiper overrides */
  .swiper-button-prev-{{ section.id }}.swiper-button-prev,
  .swiper-button-next-{{ section.id }}.swiper-button-next {
    width: 35px;
    height: 35px;
    background: rgb(var(--color-button)) !important;
    color: rgb(var(--color-button-text)) !important;
    border-radius: 50%;
    display: flex !important;
    align-items: center;
    justify-content: center;
    position: absolute;
    top: 50% !important;
    transform: translateY(-50%) !important;
    margin-top: 0 !important;
    z-index: 10;
    cursor: pointer;
  }
  
  .swiper-button-prev-{{ section.id }}.swiper-button-prev::after,
  .swiper-button-next-{{ section.id }}.swiper-button-next::after {
    font-size: 16px !important;
    font-weight: 900;
    line-height: 1;
    display: block;
  }

  {% if section.settings.carousel_type == 'card' %}
    /* Arrow Position logic for Cards */
    {% if section.settings.arrow_position == 'outside' %}
      .swiper-button-prev-{{ section.id }} { left: 20px; }
      .swiper-button-next-{{ section.id }} { right: 20px; }
      @media screen and (min-width: 1000px) {
        .swiper-button-prev-{{ section.id }} { left: calc((100% - 851px) / 4 - 6px); }
        .swiper-button-next-{{ section.id }} { right: calc((100% - 851px) / 4 + 6px); }
      }
    {% else %}
      .swiper-button-prev-{{ section.id }} { left: 20px; }
      .swiper-button-next-{{ section.id }} { right: 20px; }
    {% endif %}
    
    @media screen and (max-width: 749px) {
      .carousel-wrapper-{{ section.id }} { padding: 20px 10px; }
      .swiper-button-prev-{{ section.id }}, .swiper-button-next-{{ section.id }} { display: none; }
    }
  {% else %}
    /* Arrow Position logic for Slider */
    .swiper-button-prev-{{ section.id }} { left: 20px; }
    .swiper-button-next-{{ section.id }} { right: 20px; }
  {% endif %}

  /* Pagination Styling */
  .swiper-pagination-{{ section.id }} {
    position: absolute;
    bottom: 20px;
    left: 0;
    width: 100%;
    text-align: center;
    z-index: 10;
  }

  /* Bullet pagination styles */
  .swiper-pagination-{{ section.id }} .swiper-pagination-bullet {
    background: {{ section.settings.pagination_color_inactive | default: '#ffffff' }} !important;
    opacity: 0.5;
    transition: opacity 0.2s, background-color 0.2s;
  }
  .swiper-pagination-{{ section.id }} .swiper-pagination-bullet-active {
    background: {{ section.settings.pagination_color_active | default: '#00237d' }} !important;
    opacity: 1;
  }

  /* Numbers style pagination specifically */
  .swiper-pagination-{{ section.id }} span.swiper-pagination-bullet.swiper-number-bullet {
    width: 24px;
    height: 24px;
    line-height: 24px;
    border-radius: 50%;
    font-size: 11px;
    font-family: var(--font-body-family);
    color: {{ section.settings.pagination_color_active | default: '#00237d' }} !important;
    background: {{ section.settings.pagination_color_inactive | default: '#ffffff' }} !important;
    opacity: 0.6;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0 4px !important;
  }
  .swiper-pagination-{{ section.id }} span.swiper-pagination-bullet-active.swiper-number-bullet {
    background: {{ section.settings.pagination_color_active | default: '#00237d' }} !important;
    color: {{ section.settings.pagination_color_inactive | default: '#ffffff' }} !important;
    opacity: 1;
    font-weight: bold;
  }

  /* Counter (fraction) style pagination */
  .swiper-pagination-{{ section.id }}.swiper-pagination-fraction {
    font-family: var(--font-body-family);
    font-size: 14px;
    color: {{ section.settings.pagination_color_active | default: '#00237d' }};
  }

  {% if section.settings.carousel_type == 'card' %}
    /* In card layout, move pagination outside the card container */
    .swiper-pagination-{{ section.id }} {
      bottom: -30px;
    }
    .carousel-wrapper-{{ section.id }} {
      padding-bottom: 70px; 
    }
  {% endif %}
</style>

<div class="custom-carousel-section-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  
  {%- if section.settings.heading != blank -%}
    <div class="carousel__header page-width">
      <h2>{{ section.settings.heading | escape }}</h2>
    </div>
  {%- endif -%}

  <div class="carousel-wrapper-{{ section.id }}">
    <div class="swiper swiper-container-{{ section.id }}">
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
          {% if block.type == 'slide' %}
            {% if section.settings.carousel_type == 'card' %}
              <div class="swiper-slide swiper-slide-{{ section.id }}" {% if block.settings.link != blank %}data-link="{{ block.settings.link }}"{% endif %} {{ block.shopify_attributes }}>
                <div class="slide-background-{{ section.id }}">
                  {%- if block.settings.image != blank -%}
                    <img
                      src="{{ block.settings.image | image_url: width: 1200 }}"
                      alt="{{ block.settings.image.alt | default: 'Banner' | escape }}"
                      width="{{ block.settings.image.width }}"
                      height="{{ block.settings.image.height }}"
                      loading="lazy"
                      style="width: 100%; height: 100%; object-fit: cover;"
                    >
                  {%- else -%}
                    {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
              </div>
            {% else %}
              <div class="swiper-slide swiper-slide-{{ section.id }}" {% if block.settings.link != blank %}data-link="{{ block.settings.link }}"{% endif %} {{ block.shopify_attributes }}>
                <div class="slide-background-{{ section.id }}">
                  {%- if block.settings.image != blank -%}
                    <img
                      src="{{ block.settings.image | image_url: width: 3840 }}"
                      alt="{{ block.settings.image.alt | default: 'Slide' | escape }}"
                      width="{{ block.settings.image.width }}"
                      height="{{ block.settings.image.height }}"
                      loading="lazy"
                    >
                  {%- else -%}
                    {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
                <div class="slide-overlay-{{ section.id }}" style="background: rgba(0,0,0, {{ block.settings.image_overlay_opacity | divided_by: 100.0 }});"></div>
                <div class="slide-content-{{ section.id }}">
                  {%- if block.settings.heading != blank -%}
                    <h2 class="h1">{{ block.settings.heading | escape }}</h2>
                  {%- endif -%}
                  {%- if block.settings.button_label != blank -%}
                    <div class="banner__buttons">
                      <a {% if block.settings.link %}href="{{ block.settings.link }}"{% else %}role="link" aria-disabled="true"{% endif %} class="button button--primary">{{ block.settings.button_label | escape }}</a>
                    </div>
                  {%- endif -%}
                </div>
              </div>
            {% endif %}
          {% endif %}
        {%- endfor -%}
      </div>
      
      {% if section.settings.show_arrows %}
        {% if section.settings.carousel_type == 'slider' or section.settings.arrow_position == 'inside' %}
          <div class="swiper-button-prev-{{ section.id }} swiper-button-prev"></div>
          <div class="swiper-button-next-{{ section.id }} swiper-button-next"></div>
        {% endif %}
      {% endif %}
      
      {% if section.settings.slider_visual != 'none' %}
        <div class="swiper-pagination-{{ section.id }} swiper-pagination"></div>
      {% endif %}
    </div>

    {% if section.settings.show_arrows and section.settings.carousel_type == 'card' and section.settings.arrow_position == 'outside' %}
      <div class="swiper-button-prev-{{ section.id }} swiper-button-prev"></div>
      <div class="swiper-button-next-{{ section.id }} swiper-button-next"></div>
    {% endif %}
  </div>
</div>

<script>
  function loadSwiperAndInit{{ section.id | replace: '-', '_' }}() {
    const init = () => {
      new Swiper('.swiper-container-{{ section.id }}', {
        grabCursor: true,
        preventClicks: true,
        preventClicksPropagation: true,
        
        {% if section.settings.carousel_type == 'card' %}
          effect: 'cards',
          loop: false,
          speed: 600,
          cardsEffect: {
            perSlideOffset: 8,
            perSlideRotate: 2,
            slideShadows: true,
          },
        {% else %}
          loop: true,
          speed: 300,
        {% endif %}

        {% if section.settings.show_arrows %}
        navigation: {
          nextEl: '.swiper-button-next-{{ section.id }}',
          prevEl: '.swiper-button-prev-{{ section.id }}',
        },
        {% endif %}
        
        {% if section.settings.slider_visual != 'none' %}
        pagination: {
          el: '.swiper-pagination-{{ section.id }}',
          {% if section.settings.slider_visual == 'dots' %}
            type: 'bullets',
            clickable: true,
          {% elsif section.settings.slider_visual == 'counter' %}
            type: 'fraction',
          {% elsif section.settings.slider_visual == 'numbers' %}
            type: 'bullets',
            clickable: true,
            renderBullet: function (index, className) {
              return '<span class="' + className + ' swiper-number-bullet">' + (index + 1) + '</span>';
            },
          {% endif %}
        },
        {% endif %}
        
        on: {
          click: function (swiper, event) {
            if (event.target.closest('a') || event.target.closest('button')) return;
            const clickedSlide = swiper.clickedSlide;
            if (clickedSlide && clickedSlide.dataset.link) {
              window.location.href = clickedSlide.dataset.link;
            }
          }
        }
      });
    };

    if (typeof Swiper !== 'undefined') {
      init();
    } else {
      const script = document.createElement('script');
      script.src = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js';
      script.onload = init;
      document.head.appendChild(script);
    }
  }

  document.addEventListener('DOMContentLoaded', loadSwiperAndInit{{ section.id | replace: '-', '_' }});
  
  document.addEventListener('shopify:section:load', function(event) {
    if (event.detail.sectionId === '{{ section.id }}') {
      loadSwiperAndInit{{ section.id | replace: '-', '_' }}();
    }
  });
</script>


{% schema %}
{
  "name": "Main Carousel",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "carousel_type",
      "label": "Carousel Layout Style",
      "options": [
        {
          "value": "slider",
          "label": "Banner (Hero Slider)"
        },
        {
          "value": "card",
          "label": "Cards (Swiper Stacking Cards)"
        }
      ],
      "default": "slider"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "full_bleed",
          "label": "t:sections.slideshow.settings.layout.options__1.label"
        },
        {
          "value": "grid",
          "label": "t:sections.slideshow.settings.layout.options__2.label"
        }
      ],
      "default": "full_bleed",
      "label": "t:sections.slideshow.settings.layout.label"
    },
    {
      "type": "select",
      "id": "slide_height",
      "options": [
        {
          "value": "adapt_image",
          "label": "t:sections.slideshow.settings.slide_height.options__1.label"
        },
        {
          "value": "small",
          "label": "t:sections.slideshow.settings.slide_height.options__2.label"
        },
        {
          "value": "medium",
          "label": "t:sections.slideshow.settings.slide_height.options__3.label"
        },
        {
          "value": "large",
          "label": "t:sections.slideshow.settings.slide_height.options__4.label"
        }
      ],
      "default": "medium",
      "label": "t:sections.slideshow.settings.slide_height.label"
    },
    {
      "type": "header",
      "content": "Heading Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved By Everyday Explorers"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Autoplay Settings"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "t:sections.slideshow.settings.auto_rotate.label",
      "default": false
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 9,
      "step": 2,
      "unit": "s",
      "label": "t:sections.slideshow.settings.change_slides_speed.label",
      "default": 5
    },
    {
      "type": "select",
      "id": "image_behavior",
      "options": [
        {
          "value": "none",
          "label": "t:sections.all.animation.image_behavior.options__1.label"
        },
        {
          "value": "ambient",
          "label": "t:sections.all.animation.image_behavior.options__2.label"
        }
      ],
      "default": "none",
      "label": "t:sections.all.animation.image_behavior.label"
    },
    {
      "type": "header",
      "content": "Color Scheme"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Navigation Settings"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show Navigation Arrows",
      "default": true
    },
    {
      "type": "select",
      "id": "arrow_position",
      "label": "Arrow Position (Cards Layout)",
      "options": [
        {
          "value": "inside",
          "label": "Inside Cards"
        },
        {
          "value": "outside",
          "label": "Outside Cards"
        }
      ],
      "default": "outside"
    },
    {
      "type": "header",
      "content": "Pagination Settings"
    },
    {
      "type": "select",
      "id": "slider_visual",
      "label": "Pagination Style",
      "options": [
        {
          "value": "dots",
          "label": "Dots"
        },
        {
          "value": "counter",
          "label": "Counter"
        },
        {
          "value": "numbers",
          "label": "Numbers"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "dots"
    },
    {
      "type": "color",
      "id": "pagination_color_active",
      "label": "Pagination Active Color",
      "default": "#00237d"
    },
    {
      "type": "color",
      "id": "pagination_color_inactive",
      "label": "Pagination Inactive Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:sections.slideshow.blocks.slide.name",
      "limit": 5,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.slideshow.blocks.slide.settings.image.label"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile Image (Optional)"
        },
        {
          "type": "range",
          "id": "image_overlay_opacity",
          "min": 0,
          "max": 100,
          "step": 10,
          "unit": "%",
          "label": "t:sections.slideshow.blocks.slide.settings.image_overlay_opacity.label",
          "default": 0
        },
        {
          "type": "checkbox",
          "id": "show_content",
          "label": "Show Text Content",
          "default": false
        },
        {
          "type": "header",
          "content": "t:sections.slideshow.blocks.slide.settings.header_text.content"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "t:sections.slideshow.blocks.slide.settings.heading.label"
        },
        {
          "type": "inline_richtext",
          "id": "subheading",
          "label": "t:sections.slideshow.blocks.slide.settings.subheading.label"
        },
        {
          "type": "header",
          "content": "t:sections.slideshow.blocks.slide.settings.header_button.content"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:sections.slideshow.blocks.slide.settings.button_label.label",
          "info": "t:sections.slideshow.blocks.slide.settings.button_label.info"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.slideshow.blocks.slide.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Main Carousel",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    },
    {
      "name": "Review Cards Carousel",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}