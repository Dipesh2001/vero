{% comment %}
  Renders custom cart drawer
  Usage:
  {% render 'cart-drawer' %}
{% endcomment %}

{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'custom-cart-drawer.css' | asset_url | stylesheet_tag }}

<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'custom-cart-drawer.js' | asset_url }}" defer="defer"></script>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<style>
  .drawer {
    visibility: hidden;
  }
</style>

<cart-drawer class="drawer{% if cart == empty %} is-empty{% endif %}">
  <div id="CartDrawer" class="cart-drawer">
    <div id="CartDrawer-Overlay" class="cart-drawer__overlay"></div>
    <div
      class="drawer__inner custom-drawer__inner gradient color-{{ settings.cart_color_scheme }}"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'sections.cart.title' | t }}"
      tabindex="-1"
    >
      {%- if cart == empty -%}
        <div class="drawer__inner-empty">
          <button class="drawer__close custom-drawer__close" type="button" onclick="this.classList.add('closing'); setTimeout(() => { this.closest('cart-drawer').close(); this.classList.remove('closing'); }, 300);" aria-label="{{ 'accessibility.close' | t }}">
            <div class="close-line line-1">&nbsp;</div>
            <div class="close-line line-2">&nbsp;</div>
          </button>
          <div class="cart-drawer__warnings center">
            <div class="cart-drawer__empty-content">
              <h2 class="cart__empty-text">{{ 'sections.cart.empty' | t }}</h2>
              <a href="{{ routes.all_products_collection_url }}" class="button">
                {{ 'general.continue_shopping' | t }}
              </a>
            </div>
          </div>
        </div>
      {%- endif -%}

      <div class="drawer__header custom-drawer__header">
        <h2 class="drawer__heading">{{ settings.cart_drawer_title | default: 'Your Cart' }}</h2>
        <button class="drawer__close custom-drawer__close" type="button" onclick="this.classList.add('closing'); setTimeout(() => { this.closest('cart-drawer').close(); this.classList.remove('closing'); }, 300);" aria-label="{{ 'accessibility.close' | t }}">
          <div class="close-line line-1">&nbsp;</div>
          <div class="close-line line-2">&nbsp;</div>
        </button>
      </div>

      <cart-drawer-items {% if cart == empty %}class=" is-empty"{% endif %}>
        <form action="{{ routes.cart_url }}" id="CartDrawer-Form" class="cart__contents cart-drawer__form" method="post">
          

          <div id="CartDrawer-CartItems" class="drawer__contents js-contents">
            {%- if cart != empty -%}
              <div class="custom-cart-items-wrapper">
                {%- for item in cart.items -%}
                  <div id="CartDrawer-Item-{{ item.index | plus: 1 }}" class="cart-item custom-cart-item">
                    <div class="cart-item__media">
                      {% if item.image %}
                        <a href="{{ item.url }}" class="cart-item__link" tabindex="-1" aria-hidden="true"> </a>
                        <img class="cart-item__image" src="{{ item.image | image_url: width: 150 }}" alt="{{ item.image.alt | escape }}" loading="lazy" width="75" height="{{ 75 | divided_by: item.image.aspect_ratio | ceil }}">
                      {% endif %}
                    </div>

                    <!-- Loading Overlay -->
                    <div class="custom-cart-item-loader">
                      <svg aria-hidden="true" focusable="false" role="presentation" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
                        <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                      </svg>
                    </div>
                    
                    <div class="cart-item__details custom-item-details">
                      
                      <!-- Center Column: Title, Variant, QTY -->
                      <div class="custom-item-main-info">
                        <div class="cart-item__title-row">
                          <a href="{{ item.url }}" class="cart-item__name custom-item-title h4 break" title="{{ item.product.title | escape }}">{{- item.product.title | escape -}}</a>
                        </div>
                        
                        {%- if item.product.has_only_default_variant == false -%}
                          <div class="cart-item__variant-options custom-variant-title">
                            {%- for option in item.options_with_values -%}
                              <span>{{ option.value -}}{%- unless forloop.last %} | {% endunless %}</span>
                            {%- endfor -%}
                          </div>
                        {%- endif -%}

                        <div class="cart-item__quantity custom-item-qty">
                          <quantity-popover>
                            <quantity-input class="quantity cart-quantity">
                              <button class="quantity__button" name="minus" type="button" aria-label="Decrease quantity" onclick="this.closest('.custom-cart-item').classList.add('item-updating')">
                                <span>-</span>
                              </button>
                              <input class="quantity__input" type="number" data-quantity-variant-id="{{ item.variant.id }}" name="updates[]" value="{{ item.quantity }}" data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}" min="0" data-min="{{ item.variant.quantity_rule.min }}" {% if item.variant.quantity_rule.max != null %}max="{{ item.variant.quantity_rule.max }}"{% endif %} step="{{ item.variant.quantity_rule.increment }}" aria-label="Quantity" id="Drawer-quantity-{{ item.index | plus: 1 }}" data-index="{{ item.index | plus: 1 }}">
                              <button class="quantity__button" name="plus" type="button" aria-label="Increase quantity" onclick="this.closest('.custom-cart-item').classList.add('item-updating')">
                                <span>+</span>
                              </button>
                              <div class="quantity__rules-cart" style="display: none;">
                                <div class="loading__spinner hidden"></div>
                              </div>
                            </quantity-input>
                          </quantity-popover>
                        </div>
                      </div>

                      <!-- Right Column: Remove, Price -->
                      <div class="custom-item-actions-price">
                        <div class="cart-item__actions-wrapper custom-item-remove-wrapper">
                          <cart-remove-button id="CartDrawer-Remove-{{ item.index | plus: 1 }}" data-index="{{ item.index | plus: 1 }}">
                            <button type="button" class="cart-remove-button custom-remove-btn" aria-label="Remove {{ item.title | escape }}" data-variant-id="{{ item.variant.id }}" onclick="this.closest('.custom-cart-item').classList.add('item-updating')">
                              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                            </button>
                          </cart-remove-button>
                        </div>

                        <div class="cart-item__prices custom-item-prices">
                          {%- if item.variant.compare_at_price > item.final_price -%}
                            <div class="cart-item__discounted-prices">
                              <div class="cart-item__compare-row">
                                <s class="cart-item__old-price">{{ item.variant.compare_at_price | times: item.quantity | money }}</s>
                                {%- assign line_discount = item.variant.compare_at_price | minus: item.final_price | times: 100.0 | divided_by: item.variant.compare_at_price | round -%}
                                <span class="cart-item__discount-badge">{{ line_discount }}% OFF</span>
                              </div>
                              <span class="cart-item__final-price">{{ item.final_line_price | money }}</span>
                            </div>
                          {%- elsif item.original_line_price != item.final_line_price -%}
                            <div class="cart-item__discounted-prices">
                              <div class="cart-item__compare-row">
                                <s class="cart-item__old-price">{{ item.original_line_price | money }}</s>
                                {%- assign line_discount = item.original_line_price | minus: item.final_line_price | times: 100.0 | divided_by: item.original_line_price | round -%}
                                <span class="cart-item__discount-badge">{{ line_discount }}% OFF</span>
                              </div>
                              <span class="cart-item__final-price">{{ item.final_line_price | money }}</span>
                            </div>
                          {%- else -%}
                            <span class="cart-item__final-price">{{ item.original_line_price | money }}</span>
                          {%- endif -%}
                        </div>
                      </div>
                    </div>
                    
                    <!-- Full Width Error Message at Bottom -->
                    <div id="CartDrawer-LineItemError-{{ item.index | plus: 1 }}" class="cart-item__error custom-cart-error" role="alert">
                      <small class="cart-item__error-text"></small>
                    </div>
                  </div>
                {%- endfor -%}
              </div>
            {%- endif -%}
            
            <p id="CartDrawer-LiveRegionText" class="visually-hidden" role="status"></p>
            <p id="CartDrawer-LineItemStatus" class="visually-hidden" aria-hidden="true" role="status">{{ 'accessibility.loading' | t }}</p>
          </div>
          <div id="CartDrawer-CartErrors" role="alert"></div>
        </form>
        

      </cart-drawer-items>

      <div class="drawer__footer custom-drawer-footer">
        <!-- Discount Section -->
        {%- if settings.enable_discount_input -%}
          <div class="cart-discount-section">
            <div class="cart-discount-slider">

              <!-- View 1: Toggle row (matches Figma) -->
              <div class="cart-discount-view cart-discount-toggle">
                <!-- Left: icon -->
                <span class="cart-coupon-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="#00237d">
                    <path d="M21.41 11.58L12.41 2.58C12.05 2.21 11.55 2 11 2H4C2.9 2 2 2.9 2 4V11C2 11.55 2.21 12.05 2.59 12.42L11.59 21.42C11.95 21.79 12.45 22 13 22C13.55 22 14.05 21.79 14.41 21.41L21.41 14.41C21.79 14.05 22 13.55 22 13C22 12.45 21.78 11.94 21.41 11.58ZM6.5 8C5.67 8 5 7.33 5 6.5C5 5.67 5.67 5 6.5 5C7.33 5 8 5.67 8 6.5C8 7.33 7.33 8 6.5 8Z"/>
                    <circle cx="6.5" cy="6.5" r="1.5" fill="white"/>
                  </svg>
                </span>
                <!-- Middle: text -->
                <div class="cart-coupon-text">
                  <span class="cart-coupon-title">Coupons</span>
                  <span class="cart-coupon-sub">Apply now and save extra !</span>
                </div>
                <!-- Right: chevron -->
                <span class="cart-promo-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </span>
              </div>

              <!-- View 2: Input row -->
              <div class="cart-discount-view cart-discount-input-view">
                <div class="cart-discount-input-row">
                  <button type="button" class="cart-discount-back" aria-label="Back">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                  </button>
                  <input type="text" id="CartDrawer-Discount" class="cart-discount-input" placeholder="Enter coupon code" form="CartDrawer-Form" autocomplete="off" autocapitalize="off">
                  <button type="button" class="cart-discount-apply" onclick="applyCartDrawerDiscount()">Apply</button>
                </div>
              </div>

            </div>
          </div>
        {%- endif -%}


        {%- if settings.enable_cart_recommendations and cart != empty and cart.items.first.product_id -%}
          {%- assign first_product = cart.items.first.product -%}
          {%- assign fallback_collection = first_product.collections.first -%}
          {%- if fallback_collection == blank -%}
            {%- assign fallback_collection = collections.all -%}
          {%- endif -%}
          
          {%- capture fallback_html -%}
            {%- assign count = 0 -%}
            {%- for product in fallback_collection.products -%}
              {%- assign in_cart = false -%}
              {%- for item in cart.items -%}
                {%- if item.product_id == product.id -%}
                  {%- assign in_cart = true -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}
              
              {%- if in_cart == false and product.available -%}
                {% render 'cart-upsell-item', product: product %}
                {%- assign count = count | plus: 1 -%}
              {%- endif -%}
              {%- if count == 4 -%}{%- break -%}{%- endif -%}
            {%- endfor -%}
          {%- endcapture -%}

          {%- if count == 0 and settings.cart_drawer_collection != blank -%}
            {%- assign fallback_collection_obj = settings.cart_drawer_collection -%}
            {%- if fallback_collection_obj.products == blank -%}
              {%- assign fallback_collection_obj = collections[settings.cart_drawer_collection] -%}
            {%- endif -%}

            {%- capture fallback_html -%}
              {%- assign count = 0 -%}
              {%- for product in fallback_collection_obj.products -%}
                {%- assign in_cart = false -%}
                {%- for item in cart.items -%}
                  {%- if item.product_id == product.id -%}
                    {%- assign in_cart = true -%}
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}
                
                {%- if in_cart == false and product.available -%}
                  {% render 'cart-upsell-item', product: product %}
                  {%- assign count = count | plus: 1 -%}
                {%- endif -%}
                {%- if count == 4 -%}{%- break -%}{%- endif -%}
              {%- endfor -%}
            {%- endcapture -%}
          {%- endif -%}

          <cart-drawer-recommendations data-product-id="{{ cart.items.first.product_id }}" {% if count == 0 %}class="hidden"{% endif %}>
            {%- if count > 0 -%}
              <div class="custom-cart-recommendations">
                <h3 class="cart-recommendations-heading">{{ section.settings.heading | default: 'Grab some extras!' }}</h3>
                <div class="swiper cart-upsell-swiper">
                  <div class="swiper-wrapper">
                    {{ fallback_html }}
                  </div>
                  <div class="swiper-pagination"></div>
                  <div class="swiper-button-prev" style="display: none;"></div>
                  <div class="swiper-button-next" style="display: none;"></div>
                </div>
              </div>
            {%- endif -%}
          </cart-drawer-recommendations>
        {%- endif -%}

        <div class="cart-drawer__footer-totals custom-totals">
          <div class="totals-row">
            <span class="totals-label">{{ settings.cart_drawer_total_title | default: 'Grand Total' }}</span>
            <span class="totals-value">{{ cart.total_price | money_with_currency }}</span>
          </div>
        </div>

        <div class="cart__ctas custom-cart-ctas">
          <button type="submit" id="CartDrawer-Checkout" class="cart__checkout-button button custom-checkout-btn" name="checkout" form="CartDrawer-Form" {% if cart == empty %}disabled{% endif %}>
            Proceed Order
            <svg class="checkout-arrow" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</cart-drawer>
